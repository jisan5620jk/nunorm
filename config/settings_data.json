              "poster-img": "shopify://shop_images/Mask_group-3_1.png",
              "content": "Visible bumps or blemishes on the skin caused by oil, bacteria or dirt clogging the pores/hair follicles resulting in inflammation, redness or scarring."
            }
          },
          "02203564-83de-411d-bca8-a3c670da667a": {
            "type": "vedio-box",
            "settings": {
