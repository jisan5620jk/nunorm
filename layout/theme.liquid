    <script>
      function applyKlaviyoFormStylesOne() {
        const style = document.createElement('style');
        style.innerHTML = `
        .klaviyo-form-X2PGPY .needsclick .klaviyo-form-version-cid_1 {
            padding: 0 !important;
        }
          `;
