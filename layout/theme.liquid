          elements[elements.length - 2].style.fontWeight = '300';
          elements[elements.length - 2].style.fontStyle = 'normal';
          elements[elements.length - 2].style.lineHeight = '22px';

          elements[elements.length - 3].style.fontSize = '22px';
          elements[elements.length - 3].style.fontWeight = '300';
          elements[elements.length - 3].style.fontStyle = 'normal';
          elements[elements.length - 3].style.lineHeight = '22px';

          elements[elements.length - 1].style.color = 'rgb(251, 238, 218)';
          elements[elements.length - 1].style.fontSize = '15px';
          elements[elements.length - 1].style.fontFamily = "Montserrat, Arial, 'Helvetica Neue', Helvetica, sans-serif";
          elements[elements.length - 1].style.fontWeight = '300';
          elements[elements.length - 1].style.fontStyle = 'normal';
          elements[elements.length - 1].style.lineHeight = '22px';
        }
      }

      // Run the function 3 seconds after the page loads
      document.addEventListener('DOMContentLoaded', () => {
        setTimeout(applyKlaviyoFormStyles, 3000);
      });

      document.addEventListener('DOMContentLoaded', () => {
        // Function to handle removing the quantity element
        function handleCartItems() {
          // Select all elements with the class `.cart-item__details`
          const cartDetails = document.querySelectorAll('.cart-item__details');

          cartDetails.forEach((details) => {
            // Find the closest `.cart-item__name` element
            const cartName = details.closest('.cart-item').querySelector('.cart-item__name');

            if (cartName && cartName.innerText.trim() === 'Surprise Gift!') {
              // Find the closest `.cart-item__quantity` element and remove it
              const cartQuantity = details.closest('.cart-item').querySelector('.cart-item__quantity');
              if (cartQuantity) {
                cartQuantity.remove(); // Completely removes the element from the DOM
              }
            }
          });
        }

        // Create a MutationObserver to watch for DOM changes
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (mutation.addedNodes.length > 0) {
              // Check for `.cart-item__details` elements whenever the DOM changes
              handleCartItems();
            }
          });
        });

        // Target the container where cart items are added
        const cartContainer = document.querySelector('.cart-container'); // Replace with the actual container selector
        if (cartContainer) {
          observer.observe(cartContainer, { childList: true, subtree: true });
        }

        // Run the function initially in case elements are already present
        handleCartItems();
      });

      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }

      setInterval(() => {
        const button = document.querySelector('delivery-promise-wc'); // Select the custom web component
        if (button) {
          const nestedButton = button.querySelector('div'); // Select the first div inside the custom element
          if (nestedButton && nestedButton.shadowRoot) {
            const nestedShad = nestedButton.shadowRoot.querySelector('button'); // Select the button inside the shadow DOM
            console.log('Checking for button');
            console.log(button);
            console.log(nestedButton);
            console.log(nestedShad);

            if (nestedShad) {
              nestedButton.style.setProperty('align-items', 'flex-start', 'important');
              // Apply highest specificity CSS using combined selectors
              nestedShad.style.width = 'auto';
              nestedShad.style.backgroundColor = '#953f2f';
              nestedShad.style.color = '#fbeeda';

              // Force specificity with !important (if needed)
              nestedShad.style.setProperty('width', '22.25rem', 'important');
              nestedShad.style.setProperty('background-color', '#953f2f', 'important');
              nestedShad.style.setProperty('color', '#fbeeda', 'important');
              nestedShad.style.setProperty('border-radius', '.75rem', 'important');

              let svg = nestedShad.querySelector('svg');
              console.log(svg);
              let paths = svg.querySelectorAll('path');
              console.log(paths);
              paths.forEach((path) => {
                path.style.setProperty('fill', '#fbeeda', 'important'); // Change fill color to #fbeeda
              });

              if (window.matchMedia('(max-width: 768px)').matches) {
                nestedShad.style.setProperty('width', '90%', 'important'); // Full width for mobile
                nestedButton.style.setProperty('align-items', 'center', 'important'); // Center alignment for mobile
              }
            }

            function handleClick() {
              const element = document.getElementById('nestedShad');

              // Store the original background color
              const originalColor = element.style.backgroundColor;

              // Change the background color to black
              element.style.backgroundColor = 'black';

              // After 3 seconds, revert the background color back to the original
              setTimeout(() => {
                element.style.backgroundColor = originalColor;
              }, 3000); // 3000ms = 3 seconds
            }

            nestedShad.addEventListener('click', handleClick);
          }
        }
      }, 100);
    </script>

