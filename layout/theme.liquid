      function applyKlaviyoFormStyles() {
        // Select all matching elements
        const elements = document.querySelectorAll(
          '.klaviyo-form-X2PGPY .needsclick .klaviyo-form-version-cid_1 .needsclick .needsclick span'
        );

        // Ensure there are at least two elements before applying styles
