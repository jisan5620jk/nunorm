<section class="about_image_and_text_section layout">

{% if section.settings.img != blank %}
<img src="{{ section.settings.img | img_url:'master' }}" alt="{{ section.settings.img.alt }}" >
{% endif %}

<div class="about_image_and_text_grid">

{% for block in section.blocks %}
  <div class="img_text_box">

{% if block.settings.title != blank %}
<h2>{{ block.settings.title }}</h2>
{% endif %}

{% if block.settings.title1 != blank %}
<h4>{{ block.settings.title1 }}</h4>
{% endif %}

{% if block.settings.sub_title != blank %}
<div class="sub_title_inner">{{ block.settings.sub_title }}</div>
{% endif %} 

</div>
{% endfor %}

</div>
  
</section>
{% comment %}
{% if section.settings.buttons != blank %}
<div class="buttons_inner"><strong>{{ section.settings.buttons }}</strong><a id="typing1" class="" href="{{ section.settings.links }}">{{ section.settings.buttons6 }}</a><a id="typing" class="" href="{{ section.settings.links }}"></a><div id="cursor"></div>
</div>
{% endif %} 
{% endcomment %}

<script>
var sentences = ["{{ section.settings.buttons1 }}", "{{ section.settings.buttons2 }}", "{{ section.settings.buttons3 }}", "{{ section.settings.buttons4 }}", "{{ section.settings.buttons5 }}", "{{ section.settings.buttons6 }}"];
var currentSentence = 0;
var currentSentenceChar = 0;
var intervalValue;
var textElement = document.querySelector("#typing");
var myCursor = document.querySelector("#cursor");

function TypingEffect()
{
  var text = sentences[currentSentence].substring(0, currentSentenceChar +1);
  textElement.innerHTML = text;
  currentSentenceChar++;
  
  if(text === sentences[currentSentence])
  {
    clearInterval(intervalValue);
    setTimeout(function()
    {
      intervalValue = setInterval(DeletingEffect, 25);
    }, 130);
  }
}

function DeletingEffect()
{
  var text = sentences[currentSentence].substring(0, currentSentenceChar -1);
  textElement.innerHNTML = text;
  currentSentenceChar--;
  
  if(text === '')
  {
    clearInterval(intervalValue);
    if(currentSentence === (sentences.length-1))
       currentSentence = 0;
    else
      currentSentence++;
    
    currentSentenceChar = 0;
    
    setTimeout(function()
    {
      myCursor.style.display = 'inline-block';
      intervalValue = setInterval(TypingEffect,50);
    }, 100);
    
  }
}

intervalValue = setInterval(TypingEffect, 100);
</script>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
<script>
$(document).ready(function(){
    var text_width =  $("#typing1").width();
    var text_width_bold =  $(".buttons_inner strong").width();
    var pluse_w = text_width + 100 ;
    var text_width_bold_p = text_width_bold + 100;
    $("#typing").css("width", pluse_w);
    $("#typing").css("margin-left", text_width_bold_p);
});
</script>

<style>
  

#cursor
{
  display: inline-block;
  vertical-align: middle;
  width: 2.5px;
  height: 20px;
  animation-name: cursorMove;
  animation-duration: .75s;
  animation-timing-function: step-end;
  animation-iteration-count: infinite;
     opacity: 0;
}

@keyframes cursorMove
{
  from 
  {
    background-color: transparent;
  }
  50%
  {
    background-color: black;
  }
}

a#typing {
    position: absolute;
}

a#typing1 {
    opacity: 0;
}
  
#shopify-section-{{section.id}}:after {
    content: '';
    height: 90%;
    position: absolute;
    width: 100%;
    left: 0;
    top: -55%;
    z-index: -2;
    background-color: #fbf5ee;
}

#shopify-section-{{section.id}} {
position: relative;
}

.dammy_text_ani {
    width: 100%;
    height: 0;
    overflow: auto;
}

@media screen and (max-width: 767px) {
#shopify-section-{{section.id}}:after {
    height: 20%;
}
}

</style>


