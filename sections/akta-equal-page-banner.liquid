{{ 'equal-page.css' | asset_url | stylesheet_tag }}

<div class="content-2-column layout {{ section.settings.text_position }} mrk-equal-page">
  <div class="content-wrapper">
    <div class="column text-column">
      {% if section.settings.heading != blank %}
        <h2 class="content-heading " data-aos="fade-up" data-aos-duration="1000">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings['logo-img'] %}
        <img
          src="{{ section.settings.logo-img | image_url: width: 1200 }}"
          alt="Logo"
          loading="lazy"
          class="content-image logo-img{% if section.settings.image_radius %} has-radius{% endif %}"
          width=""
          height=""
          data-aos="fade-up"
          data-aos-duration="1500"
        >
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="content-body" data-aos="fade-up" data-aos-duration="1900">{{ section.settings.body }}</div>
      {% endif %}

      {% if section.settings.button_text != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="btn-primary">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>

    <div class="column media-column">
      {% if section.settings.media_type == 'image' %}
        {% if section.settings.image %}
          <div class="image-container ">
            <img
              src="{{ section.settings.image | image_url: width: 1200 }}"
              alt="{{ section.settings.image.alt | escape }}"
              loading="lazy"
              class="content-image{% if section.settings.image_radius %} has-radius{% endif %} content-image-test"
            >
          </div>
        {% endif %}
      {% elsif section.settings.media_type == 'video' %}
        {% if section.settings.video_url %}
          <div class="video-wrapper">
            <iframe
              src="{{ section.settings.video_url | escape }}"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Content Equal new",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "text_position",
      "label": "Text Position",
      "options": [
        { "value": "text-left", "label": "Left" },
        { "value": "text-right", "label": "Right" }
      ],
      "default": "text-left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Story"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body Text",
      "default": "<p>NuNorm began with a simple but powerful moment. Jeff, our founder, saw his kids experimenting with makeup—especially his son Quincy, who used it with such a carefree spirit that it brought out confidence and joy.</p>"
    },
    {
      "type": "image_picker",
      "id": "logo-img",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1-1", "label": "1 / 1" },
        { "value": "4-3", "label": "4 / 3" },
        { "value": "3-4", "label": "3 / 4" },
        { "value": "3-5", "label": "3 / 5" }
      ],
      "default": "1-1"
    },
    {
      "type": "checkbox",
      "id": "image_radius",
      "label": "Enable Border Radius on Image",
      "default": false
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video Embed URL (YouTube or Vimeo)"
    }
  ],
  "presets": [
    {
      "name": "Content Equal new",
      "category": "Text"
    }
  ]
}
{% endschema %}
