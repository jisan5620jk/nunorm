<!-- Link Swiper's CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css">
<style>
  .swiper-pagination1 {
    position: relative !important;
  }
  .swiper-pagination-bullet {
    text-align: center;
    line-height: 20px;
    font-size: 12px;
    color: #0f0f0f !important;
    opacity: 1;
    padding: 0 40px;
    background: none !important;
  }

  .swiper-pagination-bullet-active {
    color: #000 !important;
    background: none !important;
    padding: 20px 0;
    border-bottom: 1px solid #000;
    border-radius: 0 !important;
    border-bottom-width: 3px;
  }
</style>

<section class="blog-slider-section page-width layout">
  <!-- / heading / -->
  <h2 class="sec-heading">{{ section.settings['sec-head'] }}</h2>

  <!-- / pera / -->
  <div class="pera-wrap">{{ section.settings.content }}</div>

  <div class="blog-slider-outer swiper mySwiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {% for article in blogs[block.settings.blog].articles limit: 12 %}
          <div class="swiper-slide">
            <div class="article-imag">
              <a href="{{ article.url }}">
                {% assign blog_image = article.metafields.custom.featured_image.value %}
                {% if blog_image != blank %}
                  <img
                    src="{{ blog_image |img_url:'master'}}"
                    alt="{{ article.metafields.custom.featured_image.value.alt }}"
                  >
                {% else %}
                  <img src="{{ article.image.src | img_url: 'master' }}" alt="{{ article.image.alt }}">
                {% endif %}
              </a>
            </div>
            <div class="tag-date">
              <div class="blog-title-tag">{{ block.settings['blog-title'] }}</div>
              <span class="article-publish-date">{{ article.published_at | time_tag: format: 'date' }}</span>
            </div>
            <div class="article-title">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </div>
            <p class="article-content">
              {%- if article.excerpt.size > 0 -%}
                {{ article.excerpt | strip_html | truncatewords: 30 }}
              {%- else -%}
                {{ article.content | strip_html | truncatewords: 30 }}
              {%- endif -%}
            </p>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
    <div class="swiper-pagination swiper-pagination1"></div>
  </div>
  {% if section.settings['btn-text'] != blank %}
    <center class="center-btn">
      <div class="button_gray">
        <span class="gray_button_circle"> </span>
        <a href="{{ section.settings.btn-link }}" class="button_gray_inner">
          <span class="button_text_container">
            {{ section.settings['btn-text'] }}
          </span>
        </a>
      </div>
    </center>
  {% endif %}
</section>
<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>

<!-- Initialize Swiper -->
<script>
  var swiper = new Swiper('.mySwiper', {
    {% comment %} loop: true, {% endcomment %}
    slidesPerView: 1,
    spaceBetween: 30,
     grid: {
        rows: 2,
        fill: 'row',
      },
    breakpoints: {
      640: {
        slidesPerView: 2,
        spaceBetween: 20,
         grid: {
          rows: 2,
          fill: 'row',
        },
      },
      768: {
        slidesPerView: 3,
        spaceBetween: 40,
        slidesPerGroup: 3,
        grid: {
          rows: 2,
          fill: 'row',
        },
      },
      1024: {
        slidesPerView: 3,
        spaceBetween: 50,
        slidesPerGroup: 3,
        grid: {
          rows: 2,
          fill: 'row',
        },
      },
    },
    pagination: {
      el: '.swiper-pagination',
      clickable: true,
      renderBullet: function (index, className) {
        return '<span class="' + className + '">' + (index + 1) + '</span>';
      },
    },
  });
</script>
{% schema %}
{
  "name": "Blog Slider",
  "settings": [
    {
      "type": "text",
      "id": "sec-head",
      "label": "heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Descrition"
    },
    {
      "type": "text",
      "id": "btn-text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "btn-link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "box",
      "name": "box",
      "limit": 4,
      "settings": [
        {
          "type": "blog",
          "id": "blog",
          "label": "Add Blog"
        },
        {
          "type": "text",
          "id": "blog-title",
          "label": "Blog Tag"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog Slider"
    }
  ]
}
{% endschema %}
