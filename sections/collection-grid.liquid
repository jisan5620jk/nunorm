    }


    .text-overlay h3 em {
    display: inline-block;
  }


  @media (max-width: 767px) {

    .text-overlay {
      text-align: center;
      left: 6%;
      right: 6%;
    }

    #mb-overlay *:not(em) {
      color: #213346;
    }
  }
</style>
