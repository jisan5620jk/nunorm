{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "class": "full-width home-collection-main",
  "settings": [
    {
      "type": "text",
      "id": "custom_title",
      "label": "Custom Section Title",
      "default": "Best Sellers"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "btn-primary",
      "options": [
        { "value": "btn-primary", "label": "Primary Button" },
        { "value": "btn-secondary", "label": "Secondary Button" },
        { "value": "btn-tertiary", "label": "Tertiary Button" },
        { "value": "btn-fourth", "label": "Fourth Button" }
      ]
    },
    {
      "type": "select",
      "id": "button_style_bottom",
      "label": "Button Style bottom",
      "default": "btn-primary",
      "options": [
        { "value": "btn-primary", "label": "Primary Button" },
        { "value": "btn-secondary", "label": "Secondary Button" },
        { "value": "btn-tertiary", "label": "Tertiary Button" }
      ]
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Static Image"
    },
    {
      "type": "richtext",
      "id": "headline_text",
      "label": "Headline Text"
    },
    {
      "type": "richtext",
      "id": "subheadline_text",
      "label": "Subheadline Text"
    },
    {
      "type": "richtext",
      "id": "headline2_text",
      "label": "Headline 2 Text"
    },
    {
      "type": "richtext",
      "id": "subheadline2_text",
      "label": "Subheadline 2 Text"
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Headline Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subheadline_color",
      "label": "Subheadline Text Color",
      "default": "#000000"
    },
    {
      "type": "collection",
      "id": "product_collection",
      "label": "Product Collection"
    },
    {
      "type": "select",
      "id": "collection_side",
      "label": "Collection Side",
      "default": "right",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "ticker_word",
      "name": "Ticker Word",
      "settings": [{ "type": "text", "id": "word", "label": "Word" }]
    }
  ],
  "max_blocks": 30,
  "presets": [{ "name": "Collection Grid" }]
}
{% endschema %}

<section id="custom-collection-section" class="layout">
  <div class="section-title-wrap">
    <h2 class="section-title">
      {{ section.settings.custom_title | default: collections[section.settings.product_collection].title }}
    </h2>
  </div>
  <div class="collection-container {% if section.settings.collection_side == 'left' %}reverse{% endif %}">
    <div class="left-column">
      <div class="img-overlay"></div>
      {% if section.settings.left_image != blank %}
        <img src="{{ section.settings.left_image | img_url: '800x' }}" alt="Left Image">
      {% endif %}
      <div id="overlay-a" class="text-overlay">
        <div class="headline">{{ section.settings.headline_text }}</div>
        <div class="subheadline">{{ section.settings.subheadline_text }}</div>
      </div>
      <div id="overlay-b" class="text-overlay bottom-stick">
        <div class="headline">{{ section.settings.headline2_text }}</div>
        <div class="subheadline">{{ section.settings.subheadline2_text }}</div>
      </div>
    </div>
    <div class="right-column">
      <div class="product-grid">
        {% for product in collections[section.settings.product_collection].products limit: 6 %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
      <div class="button-container">
        <a
          class="prod-cta-view-all {{ section.settings.button_style_bottom }}"
          href="{{ section.settings.product_collection.url }}"
        >
          View All Products
        </a>
      </div>
    </div>
    <div id="mb-overlay" class="text-overlay bottom-stick">
      <div class="headline">{{ section.settings.headline2_text }}</div>
      <div class="subheadline">{{ section.settings.subheadline2_text }}</div>
    </div>
  </div>
</section>

<!-- Animation Styles -->
<style>
  #custom-collection-section .text-overlay {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  #custom-collection-section .text-overlay.show {
    opacity: 1;
    transform: translateY(0);
  }

  /* Disable animation on mobile */
  @media (max-width: 768px) {
    {% comment %} #custom-collection-section .text-overlay {
      opacity: 1 !important;
      transform: translateY(0) !important;
      transition: none !important;
    }
    #overlay-b{
    display: none;
  } {% endcomment %}
  #custom-collection-section .text-overlay.animate {
      opacity: 1 !important;
      transform: translateY(-30px) !important;
  }
  #custom-collection-section .text-overlay.show:not(.animate) {
      opacity: 0;
  }
  #overlay-a {
      bottom: 11% !important;
  }
  #custom-collection-section .text-overlay.show {
      transform: translateY(-100px) !important;
  }

  div#mb-overlay {
      display: none;
  }
  }
  @media (min-width: 550px){
  #mb-overlay{
    display: none !important;
  }
  }
  @media (max-width: 549px){
  #mb-overlay{
    position: relative !important;
    order: 3 !important;
    text-align: center !important;
    left:0 !important;
    right:0 !important;
  }
  }
  #custom-collection-section .text-overlay:not(.bottom-stick) {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity .6s ease, transform .6s ease;
  }
  #custom-collection-section .text-overlay.show {
    opacity: 1;
    transform: translateY(0);
  }

  /* Bottom/sticky overlay B states */
  #custom-collection-section .text-overlay.bottom-stick {
    position: absolute;
    bottom: 12%;
    left: 5%;
    right: 10%;
    z-index: 1;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity .6s ease, transform .6s ease;
    pointer-events: none;
    z-index: 2; /* ensure it’s above background */
  }
  #custom-collection-section .text-overlay.bottom-stick.is-on {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  #overlay-a{
   bottom: 10% !important;
  }

  @media(max-width: 1440px){
    #overlay-a{
    bottom: 12% !important;
    }
  }
  @media(max-width: 1024px){
    #overlay-b{
    bottom: 8% !important;
    }
  }
  @media(max-width: 768px){
    #overlay-b{
    bottom: 15% !important;
    }
  }
  @media(max-width: 768px){
    #overlay-b{
    bottom: 15% !important;
    }
  }
  @media(max-width: 375px){
    #overlay-b{
    bottom: 12% !important;
    }
  }
</style>

<!-- Animation Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('custom-collection-section');
    const textOverlay = section.querySelector('.text-overlay');

    let lastScrollTop = window.pageYOffset || document.documentElement.scrollTop;

    function handleScroll() {
      // Disable animation on mobile
      if (window.innerWidth < 768) {
        textOverlay.classList.add('show');
        return;
      }

      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight || document.documentElement.clientHeight;
      const sectionHeight = rect.height;

      let currentScroll = window.pageYOffset || document.documentElement.scrollTop;
      let scrollDirection = currentScroll > lastScrollTop ? 'down' : 'up';
      lastScrollTop = currentScroll <= 0 ? 0 : currentScroll;

      let isHalfVisible = rect.top <= windowHeight / 2 && rect.bottom >= sectionHeight / 2;

      if (isHalfVisible) {
        textOverlay.classList.add('show');
      } else {
        textOverlay.classList.remove('show');
      }
    }

    window.addEventListener('scroll', handleScroll);
    handleScroll(); // Trigger once on load
  });
</script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const a = document.getElementById('overlay-a'); // first overlay
    const b = document.getElementById('overlay-b'); // second overlay (bottom)

    if (!a || !b) return;

    function sync() {
      const aVisible = a.classList.contains('show');
      // When A loses .show, B should slide up & stick to bottom
      b.classList.toggle('is-on', !aVisible);
      b.setAttribute('aria-hidden', aVisible ? 'true' : 'false');
    }

    // Run once on load
    sync();

    // React immediately when A's classes change
    const mo = new MutationObserver((muts) => {
      for (const m of muts) {
        if (m.attributeName === 'class') {
          sync();
          break;
        }
      }
    });
    mo.observe(a, { attributes: true, attributeFilter: ['class'] });

    // Also sync right after A finishes fading (for smoothness)
    a.addEventListener('transitionend', (e) => {
      if (e.propertyName === 'opacity' || e.propertyName === 'transform') {
        sync();
      }
    });
  });
</script>

{% comment %} MOBILE USE ANIMATION {% endcomment %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const overlayA = document.getElementById('overlay-a');
    const overlayB = document.getElementById('overlay-b');
    const img = document.querySelector('.left-column img');

    let timeoutId; // store timeout so it doesn’t repeat

    function handleScroll() {
      if (window.innerWidth < 768) {
        const rect = img.getBoundingClientRect();
        const windowHeight = window.innerHeight;

        if (rect.bottom <= windowHeight) {
          overlayA.classList.remove('animate');
          overlayB.classList.add('animate');

          // only start timer if not already running
          if (!timeoutId) {
            timeoutId = setTimeout(() => {
              overlayB.classList.remove('animate'); // remove after 10s
              // OR replace text content
              // overlayB.querySelector(".headline").innerHTML = "<h3>New Text Here</h3>";
            }, 10000); // 10 seconds
          }
        } else {
          overlayA.classList.add('animate');
          overlayB.classList.remove('animate');

          // reset timer when user scrolls back up
          clearTimeout(timeoutId);
          timeoutId = null;
        }
      } else {
        // desktop default
        overlayA.classList.add('animate');
        overlayB.classList.remove('animate');
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  });
</script>

<!-- Styles (Full) -->
<style>
    /* Ticker */
    .ticker-wrapper {
      overflow: hidden;
      white-space: nowrap;
      width: 100%;
    }
    .button-container {
      padding: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .prod-cta-view-all {
      margin: 0 auto;
    }
    .ticker {
      display: inline-block;
      white-space: nowrap;
      animation: ticker-move 80s linear infinite;
    }
    .ticker span {
      font-size: 20px;
      font-family: 'Montserrat';
      font-style: italic;
      color: #213346;
      font-weight: 300;
    }
    @keyframes ticker-move {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .section-title-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin: 60px 0px;
    }
    .section-title {
      text-transform: uppercase;
      color: #8C2A26;
    }
    .collection-container {
      display: flex;
      flex-wrap: wrap;
      gap: 40px;
    }
    .collection-container.reverse {
      flex-direction: row-reverse;
    }
    .left-column {
      flex: 1 1 40%;
      position: sticky;
      height: 100dvh;
      top: 0;
    }
    .left-column img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }
    .img-overlay {
      width: 100%;
      height: 100vh;
      position: absolute;
      top: 0;
      left: 0;
      background: linear-gradient(0deg, rgba(33, 51, 70, 1) 0%, rgba(33, 51, 70, 0) 100%);
      opacity: .25;
      z-index: 0;
    }
    .text-overlay {
      position: absolute;
      bottom: 12%;
      left: 10%;
      right: 10%;
      z-index: 1;
    }
    .headline > h1, .headline > h2, .headline > h3, .headline > h4, .headline > h5, .headline > p {
      color: {{ section.settings.headline_color }};
      margin: 0;
    }
    .subheadline > h1, .subheadline > h2, .subheadline > h3, .subheadline > h4, .subheadline > h5, .subheadline > p {
      color: {{ section.settings.subheadline_color }};
      margin: 0;
    }
    .right-column {
      flex: 1 1 50%;
    }
    .product-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .product-card {
      padding: 16px;
      text-align: center;
    }
    .product-card img {
      width: 100%;
      height: 100%;
      position: absolute;
      top: 0;
      left: 0;
      object-fit: cover;
      z-index: 0;
    }


    .product-title {
      margin-top: 8px;
      font-family: 'Montserrat';
      font-size: 16px;
      color: #213346;
    }
    .product-variants {
      font-family: 'Montserrat';
      font-size: 14px;
      font-weight: 700;
      color: #8C2A26;
      margin-top: 10px;
    }
    @media (max-width: 768px) {
      .collection-container {
        flex-direction: column !important;
      }
      .left-column {
        width: 100%;
        position: relative;
        height: 60dvh;
        min-height: 350px;
        top: 0;
        flex: unset;
      }
      .img-overlay {
        height: 100%;
      }

      .collection-container.reverse .left-column img {
        height: 600px;
      }
      .left-column img {
        height: 860px;
      }
      #overlay-a {
          bottom: 7% !important;
      }
      #overlay-b {
          bottom: 15% ;
      }
