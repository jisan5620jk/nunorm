{{ 'collection-home-main.css' | asset_url | stylesheet_tag }}
{{ 'section-collection-slider.css' | asset_url | stylesheet_tag }}

<section class="core-collection-home page-width layout">
  <!-- / heading sec / -->
  <div class="nunorm-header nunorm-header--center">
    {%- if section.settings.title != blank -%}
      <h2 class="title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    {%- if section.settings.desc != blank -%}
      <p class="desc">{{ section.settings.desc }}</p>
    {%- endif -%}
  </div>

  <div class="wrap-home-resources ">
    <div class="home-resources-content">
      <div class="container">
        <div class="row">
          <div class="col-md-12">
            <div id="carousel-home-resources" class="carousel-home-resources">
              <carousel-3d
                :perspective="0"
                :border="0"
                :width="carouselWidth"
                :height="carouselHeight"
                :controls-visible="false"
                :space="carouselSpace"
                :clickable="true"
              >
                {% for block in section.blocks %}
                  {% liquid
                    assign count = forloop.index
                    assign product = block.settings.product
                  %}

                  <slide :index="{{ forloop.index0 }}">
                    <article
                      class="core_slider_main_box core_slider_main_{{ forloop.index }}"
                      data-index="{{ forloop.index }}"
                    >
                      <div class="video_image_box">
                        {% assign feature_image = product.metafields.custom.home_page_image.value
                          | image_url: width: 800
                        %}
                        {% if feature_image != blank %}
                          <a href="{{ product.url }}">
                            <img
                              data-index="{{ forloop.index }}"
                              data-component-product-swatch-image
                              height="{{ product.metafields.custom.home_page_image.value.height }}"
                              width="{{  product.metafields.custom.home_page_image.value.width }}"
                              loading="lazy"
                              class="product-img"
                              data-src="{{feature_image}}"
                              src="{{ feature_image }}"
                              alt="{{ product.metafields.custom.home_page_image.value.alt }}"
                              data-was-processed="true"
                            >
                          </a>
                        {% endif %}
                      </div>

                      <div class="text_details_box">
                        <h2 class="CS_card-header">
                          <a class="full-unstyled-link" href="{{ product.url }}">{{ product.title }}</a>
                        </h2>
                        {% assign short-description = product.metafields.custom.description.value %}
                        {% if short-description != blank %}
                          <p class="feature-item__copy">{{ short-description | strip_html | truncate: 150 }}</p>
                        {% endif %}

                        <product-form>
                          {% liquid
                            assign custom_form_id = 'desk-form-' | append: count
                          %}
                          {% form 'product',
                            product,
                            id: custom_form_id,
                            data-component-add-to-cart-form: '',
                            data-index: count,
                            data-type: 'add-to-cart-form',
                            novalidate: 'novalidate',
                            class: 'ContactForm center'
                          %}
                            <!-- swatches -->
                            {% render 'color-swatches', product: product, count: count, form_id: false %}
                            <!-- Start of Judge.me code -->
                            <div class="jdgm-widget jdgm-preview-badge">
                              {{ product.metafields.judgeme.badge }}
                            </div>
                            <!-- End of Judge.me code -->
                            {{ 'judgeme-overwrite.css' | asset_url | stylesheet_tag }}

                            <div class="button-box-outer">
                              <!-- / button / -->
                              <div class="button_gray">
                                <span class="gray_button_circle"> </span>
                                <div class="button_gray_inner">
                                  <span class="button_text_container ">
                                    <input
                                      data-component-variant-id-input
                                      data-variant-input-index="{{ count }}"
                                      class="dark_{{ forloop.index }}"
                                      type="hidden"
                                      name="id"
                                      id="variant-id-{{ count }}"
                                      value="{{ product.variants.first.id }}"
                                    >
                                    <input min="1" type="hidden" id="quantity" name="quantity" value="1">
                                    <input
                                      data-index="{{ count }}"
                                      data-component-add-to-cart-form-submit
                                      class="dark_{{ forloop.index }}"
                                      type="submit"
                                      value="Add to cart •&nbsp;{{ product.price | money }}"
                                      class="button"
                                    >
                                  </span>
                                </div>
                              </div>

                              <!-- / button / -->
                              <div class="button_gray try_it">
                                <span class="gray_button_circle"> </span>
                                <a class="button_gray_inner pink_{{ forloop.index }}">
                                  <span class="button_text_container">
                                    {{ block.settings['btn-text'] }}
                                  </span>
                                </a>
                              </div>
                            </div>

                            <div class="buton_core">
                              <button class="btn_main_dark btn_core_dark_{{ forloop.index }}">
                                Add to cart •&nbsp;<span class="slide-variant-btn">{{ product.price | money }}</span>
                              </button>
                              {% if product.metafields.custom.try_on_button.value != false %}
                                <a
                                  data-component-product-anchor
                                  data-index="{{ count }}"
                                  href="{{ block.settings.btn-link }}"
                                  class="btn_main_pink  btn_core_pink_{{ forloop.index }}"
                                >
                                  {{ block.settings['btn-text'] -}}
                                </a>
                              {% endif %}
                            </div>
                          {% endform %}
                        </product-form>

                        {% if product.metafields.custom.product_badges.value != blank %}
                          <div class="product-card__badgelist">
                            {% for badge in product.metafields.custom.product_badges.value %}
                              {{ badge | image_url: width: 150 | image_tag: class: 'product-card__product-badge' }}
                            {% endfor %}
                          </div>
                        {% endif %}
                      </div>
                    </article>
                  </slide>
                {% endfor %}
              </carousel-3d>
            </div>
            <div class="slider-pagination">
              {% for block in section.blocks %}
                <div class="slider-item-nimber slide-number-{{ forloop.index }} {%if forloop.index == 1 %}active{% endif %}">
                  {{ forloop.index }}
                </div>
                <script>
                  $(document).ready(function () {
                    $('.slide-number-{{ forloop.index }}').click(function () {
                      $('.pagination-arrow-right.active').removeClass('active');
                      $('.core_slider_main_{{ forloop.index}}').click();
                      $('.slider-item-nimber.active').removeClass('active');
                      $(this).addClass('active');
                    });
                  });
                </script>
              {% endfor %}
              <div class="pagination-arrow-right">
                <img
                  class="pagination-arrow-right-element"
                  loading="lazy"
                  height="20"
                  width="20"
                  src="{{ 'Vector_1_49141a6a-a547-43c5-ba61-9820366bf4ac.png' |  file_img_url }}"
                >
              </div>
            </div>
            {% if section.settings['explore-text'] != blank %}
              <div class="custom-btn-home">
                <a href="{{ section.settings.explore-link }}" class="custom-collection-home-link">
                  {{- section.settings['explore-text'] -}}
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<script src="https://cdnjs.cloudflare.com/ajax/libs/vue/2.6.10/vue.min.js"></script>

<script src="https://wlada.github.io/vue-carousel-3d/js/carousel-3d.umd.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const carouselHomeResources = document.getElementById('carousel-home-resources');
    var name = Math.round(carouselHomeResources.getBoundingClientRect().width) / 1.4;
    $('.carousel-3d-slider').css('width', name / 1.4);
    $('.carousel-3d-slide').css('width', name / 1.4);

    new Vue({
      el: '#carousel-home-resources',
      data: {
        slides: 3,
        carouselWidth: window.innerWidth < 768 ? 720 : 1078,
        carouselSpace: window.innerWidth < 768 ? 60 : 500,
        carouselHeight: window.innerWidth < 768 ? 720 : 680,
      },
      components: {
        'carousel-3d': window['carousel-3d'].Carousel3d,
        slide: window['carousel-3d'].Slide,
      },
      mounted() {
        this.updateCarouselDimensions();
        window.addEventListener('resize', this.updateCarouselDimensions);
        this.$nextTick(function () {
          document.dispatchEvent(new Event('vueCarouselRendered'));
        });
      },
      methods: {
        updateCarouselDimensions() {
          if (window.innerWidth < 768) {
            this.carouselWidth = window.innerWidth - 50;
            this.carouselHeight = 720;
            this.carouselSpace = 60;
          } else {
            this.carouselWidth = 1078;
            this.carouselHeight = 680;
            this.carouselSpace = 500;
          }
        },
      },
    });

    $('.variant-input input').click(function () {
      var data = $(this).attr('data-id');
      $('#variant-id').val(data);
    });

    $('.pagination-arrow-right').click(function () {
      $(this).addClass('active');
      $('.right-1').click();
      var number = $('.right-1 .core_slider_main_box').attr('data-index');
      $('.slider-item-nimber.active').removeClass('active');
      $('.slide-number-' + number).addClass('active');
    });

    $('.carousel-3d-slide').click(function () {
      setTimeout(function () {
        var number1 = $('.carousel-3d-slide.current .core_slider_main_box').attr('data-index');
        $('.slider-item-nimber.active').removeClass('active');
        $('.slide-number-' + number1).addClass('active');
        $('.pagination-arrow-right').removeClass('active');
      }, 500);
    });
  });
</script>

{% schema %}
{
  "name": "collection home desk",
  "class": "collection_home_main",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "inline_richtext",
      "id": "desc",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "explore-text",
      "label": "Explore more text",
      "default": "Explore more"
    },
    {
      "type": "url",
      "id": "explore-link",
      "label": "Explore Link"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "core-collection-home",
      "settings": [
        {
          "type": "url",
          "id": "video",
          "label": "Add Video Url"
        },
        {
          "type": "image_picker",
          "id": "poster-img",
          "label": "Add Poster Image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Add Product"
        },
        {
          "type": "text",
          "id": "btn-text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "btn-link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "collection home desk"
    }
  ]
}
{% endschema %}
