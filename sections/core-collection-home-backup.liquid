{% schema %}
{
  "name": "core-collection-home-mob",
   "class": "core-collection-home-mob",
  "settings": [
  {
    "type": "liquid",
    "id": "logos-home",
    "label": "t:sections.custom-liquid.settings.custom_liquid.label",
    "info": "t:sections.custom-liquid.settings.custom_liquid.info"
  },
  {
    "type": "text",
    "id": "sec-heading",
    "label": "Heading"
  },
