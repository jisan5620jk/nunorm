<style>
  .pg-section-wrapper {
    background: linear-gradient(90deg, #F7D3A1 0%, #FBEEDA 100%);
    padding: 112px 16px 80px;
  }

  .pg-container {
    max-width: 1320px;
    margin: 0 auto;
  }

  /* Header */
  .pg-header {
    text-align: center;
    margin: 0 auto 67px auto;
  }

  .pg-heading {
    color: #213346;
    font-family: 'Point Panther';
    font-weight: 700;
    font-size: 32px;
    line-height: 145%;
    letter-spacing: 0.6px;
    text-align: center;
    vertical-align: middle;
    text-transform: uppercase;
    margin: 0 0 23px;
  }

  .pg-description {
    color: #213346;
    font-family: 'Montserrat';
    font-weight: 400;
    font-size: 20px;
    line-height: 28px;
    letter-spacing: 0.6px;
    text-align: center;
    vertical-align: middle;
    max-width: 890px;
    width: 100%;
    margin: 0 auto;
  }

  /* Grid Layout */
  .pg-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr); /* 2 Columns */
    gap: 68px 56px;
    margin-bottom: 50px;
    min-height: 400px; /* Prevent layout shift during JS load */
    align-items: stretch;
  }

  /* Card Component */
  .pg-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    /* Cards are hidden by default, shown via JS */
    display: none;
    animation: fadeIn 0.4s ease-out forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Media Area */
  .pg-media {
    position: relative;
    width: 100%;
    height: auto; /* Fixed height for consistency */
    padding: 0 9.3px;
    margin: 0 0 16px;
    overflow: hidden;
    border-radius: 24px;
  }

  .pg-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    overflow: hidden;
    border-radius: 24px;
    transition: transform 0.5s ease-in-out;
  }

  .pg-bg-image.placeholder {
    opacity: 0.5;
  }

  /* Logo Overlay */
  .pg-logo-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: #F8E8D4; /* Matches section bg */
    padding: 20px;
    width: 180px;
    height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  .pg-logo {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .pg-logo-text {
    font-weight: bold;
    font-size: 18px;
    color: #8B4533;
  }

  /* Text Content */

  .pg-card-title {
    margin: 0;
    font-family: Montserrat;
    font-weight: 900;
    font-style: italic;
    font-size: 20px;
    line-height: 30px;
    letter-spacing: 0.6px;
    vertical-align: middle;
    text-transform: uppercase;
  }

  .pg-card-title a {
    color: #213345;
    text-decoration: none;;
  }

  .pg-card-excerpt {
    color: #213346;
    font-family: Montserrat;
    font-weight: 400;
    font-size: 16px;
    line-height: 19.2px;
    letter-spacing: 0.6px;
    vertical-align: middle;
    margin: 8px 0 16px;
  }

  .pg-read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #7A1C20;
    text-decoration: none;
    margin-top: auto;
    transition: color 0.3s ease;
    font-family: Montserrat;
    font-weight: 700;
    font-size: 14px;
    line-height: 25.2px;
    letter-spacing: 0.6px;
    text-align: center;
    vertical-align: middle;
    text-transform: uppercase;
  }

  .pg-read-more:hover {
    color: #1A2A3A;
  }

  /* Pagination */
  .pg-pagination-container {
    display: flex;
    justify-content: center;
    margin-bottom: 24px;
    padding-top: 32px;
    width: max-content;
    margin-left: auto;
    margin-right: auto;
  }

  .pg-page-number {
    font-family: Montserrat;
    width: 87.59px;
    font-weight: 400;
    padding: 17px;
    font-size: 12px;
    line-height: 20px;
    letter-spacing: 0.6px;
    text-align: center;
    vertical-align: middle;
    background: transparent;
    color: #000000;
    outline: none;
    border: none;
    box-shadow: none;
    cursor: pointer;
    border-bottom: 1px solid #CDCCCC;
    transition: border-bottom 0.3s ease, color 0.3s ease;
  }

  .pg-page-number.active {
    border-bottom: 3px solid #000000;
    font-weight: 600;
  }

  /* Footer Button */
  .pg-footer {
    text-align: center;
  }

  .pg-view-btn {
    display: inline-block;
    background: #933F2C;
    color: #FBEEDA;
    padding: 18.8px 56px;
    text-decoration: none;
    font-family: Montserrat;
    font-weight: 700;
    font-size: 18px;
    line-height: 100%;
    letter-spacing: 0;
    text-align: center;
    vertical-align: middle;
    border-radius: 10px;
    transition: background-color 0.3s ease;
  }

  .pg-view-btn:hover {
    background-color: #6d3223;
  }

  /* Responsive Mobile */
  @media (max-width: 767px) {

    .pg-section-wrapper {
      padding: 70px 16px 80px;
    }
    .pg-grid {
      grid-template-columns: 1fr; /* Stack columns */
      gap: 40px;
    }

    .pg-heading {
      font-size: 24px;
    }

  }
  @media (max-width: 575px) {
    .pg-header {
      margin: 0 auto 47px auto;
    }

    .pg-description {
      font-size: 18px;
      line-height: 26px;
    }

    .pg-pagination-container {
      padding-top: 12px;
    }
  }
</style>

<div class="pg-section-wrapper">
  <div class="pg-container">
    {% comment %} --- HEADER SECTION --- {% endcomment %}
    <header class="pg-header">
      <h2 class="pg-heading">{{ section.settings.heading }}</h2>
      <div class="pg-description">{{ section.settings.description }}</div>
    </header>

    {% comment %} --- GRID SECTION --- {% endcomment %}
    <div class="pg-grid" id="pg-grid-{{ section.id }}">
      {% assign selected_blog = section.settings.blog_source %}

      {% comment %} CHECK IF BLOG IS SELECTED {% endcomment %}
      {% if selected_blog != blank %}
        {% for article in selected_blog.articles limit: section.settings.post_limit %}
          <article class="pg-card">
            {% comment %} MEDIA: Featured Image {% endcomment %}
            <div class="pg-media">
              {% if article.image != blank %}
                <a href="{{ article.url }}" class="pg-media-link" aria-label="{{ article.title | escape }}">
                  <img
                    src="{{ article.image | image_url }}"
                    loading="lazy"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    class="pg-bg-image"
                    width="{{ article.image.width }}"
                    height="{{ article.image.height }}"
                  >
                </a>
              {% else %}
                <a href="{{ article.url }}" class="pg-media-link" aria-label="{{ article.title | escape }}">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'pg-bg-image placeholder' }}
                </a>
              {% endif %}
            </div>

            {% comment %} CONTENT {% endcomment %}
            <h3 class="pg-card-title">
              <a href="{{ article.url }}" class="pg-title-link">
                {{ article.title }}
              </a>
            </h3>

            <p class="pg-card-excerpt">
              {% if article.excerpt.size > 0 %}
                {{ article.excerpt | strip_html | truncatewords: 20 }}
              {% else %}
                {{ article.content | strip_html | truncatewords: 20 }}
              {% endif %}
            </p>

            <a href="{{ article.url }}" class="pg-read-more">
              {{ section.settings.read_more_label }}
              <svg width="13" height="13" viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12.0649 0.000611899C12.2637 0.000735652 12.4543 0.0797436 12.5948 0.220281C12.7353 0.360819 12.8143 0.551394 12.8145 0.750145L12.8145 9.23543C12.818 9.33608 12.8013 9.43642 12.7652 9.53046C12.7291 9.6245 12.6745 9.71031 12.6045 9.78278C12.5346 9.85524 12.4508 9.91287 12.358 9.95223C12.2653 9.9916 12.1656 10.0119 12.0649 10.0119C11.9642 10.0119 11.8645 9.9916 11.7718 9.95223C11.6791 9.91287 11.5953 9.85524 11.5253 9.78278C11.4554 9.71031 11.4007 9.6245 11.3647 9.53046C11.3286 9.43642 11.3118 9.33608 11.3154 9.23543L11.3154 2.56034L1.28155 12.5942C1.1409 12.7348 0.950133 12.8139 0.751221 12.8139C0.552309 12.8139 0.361543 12.7348 0.220891 12.5942C0.0802392 12.4535 0.00122164 12.2628 0.0012213 12.0639C0.00122097 11.8649 0.0802396 11.6742 0.220891 11.5335L10.2547 1.49968L3.57965 1.49968C3.47899 1.50323 3.37865 1.48647 3.28461 1.45041C3.19057 1.41434 3.10476 1.3597 3.0323 1.28975C2.95983 1.2198 2.9022 1.13597 2.86284 1.04326C2.82348 0.95055 2.80319 0.850863 2.80319 0.750144C2.80319 0.649426 2.82348 0.549739 2.86284 0.457031C2.9022 0.364323 2.95983 0.280493 3.0323 0.210542C3.10476 0.140591 3.19057 0.0859511 3.28461 0.0498833C3.37865 0.0138155 3.47899 -0.00294129 3.57965 0.000611656L12.0649 0.000611899Z" fill="#7A1C20"/>
              </svg>
            </a>
          </article>
        {% endfor %}

      {% else %}
        {% comment %} PLACEHOLDER CONTENT (If no blog selected in editor) {% endcomment %}
        {% for i in (1..3) %}
          <article class="pg-card">
            <div class="pg-media">
              {{ 'image' | placeholder_svg_tag: 'pg-bg-image placeholder' }}
            </div>
            <div class="pg-content">
              <h3 class="pg-card-title">Example Blog Title</h3>
              <p class="pg-card-excerpt">
                Select a blog in the section settings to populate this grid with real content.
              </p>
              <span class="pg-read-more">{{ section.settings.read_more_label }}</span>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>

    {% comment %} --- PAGINATION CONTROLS --- {% endcomment %}
    <div class="pg-pagination-container" id="pg-pagination-{{ section.id }}" style="display:none;">
      <!-- JS will inject buttons here -->
    </div>

    {% comment %} --- FOOTER BUTTON --- {% endcomment %}
    {% if section.settings.show_footer_btn %}
      <div class="pg-footer">
        <a href="{{ section.settings.footer_btn_link | default: selected_blog.url }}" class="pg-view-btn">
          {{ section.settings.footer_btn_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sectionId = '{{ section.id }}';
    const gridContainer = document.getElementById(`pg-grid-${sectionId}`);
    const paginationContainer = document.getElementById(`pg-pagination-${sectionId}`);

    // Get all card elements
    const cards = Array.from(gridContainer.children);
    const totalItems = cards.length;
    const itemsPerPage = {{ section.settings.item_per_page }};

    // If we have 4 or fewer items, show them all and stop.
    if (totalItems <= itemsPerPage) {
      cards.forEach((card) => (card.style.display = 'flex'));
      return;
    }

    // Logic for more than 4 items
    const totalPages = Math.ceil(totalItems / itemsPerPage);
    paginationContainer.style.display = 'flex';

    function renderPage(pageNumber) {
      // Calculate start and end index
      const startIndex = (pageNumber - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;

      // Loop through all cards
      cards.forEach((card, index) => {
        if (index >= startIndex && index < endIndex) {
          card.style.display = 'flex'; // Show card
        } else {
          card.style.display = 'none'; // Hide card
        }
      });

      // Update Pagination Active State
      const buttons = paginationContainer.querySelectorAll('.pg-page-number');
      buttons.forEach((btn) => {
        btn.classList.remove('active');
        if (parseInt(btn.dataset.page) === pageNumber) {
          btn.classList.add('active');
        }
      });
    }

    // Generate Pagination Buttons
    for (let i = 1; i <= totalPages; i++) {
      const btn = document.createElement('button');
      btn.textContent = i;
      btn.classList.add('pg-page-number');
      btn.dataset.page = i;

      // Add Click Event
      btn.addEventListener('click', function () {
        renderPage(i);
      });

      paginationContainer.appendChild(btn);
    }

    // Initialize Page 1
    renderPage(1);
  });
</script>

{% schema %}
{
  "name": "Dynamic Blog Grid",
  "settings": [
    {
      "type": "header",
      "content": "Content Source"
    },
    {
      "type": "blog",
      "id": "blog_source",
      "label": "Select Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 1,
      "max": 100,
      "step": 1,
      "label": "Number of articles to show",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_per_page",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Item Show Per Page",
      "default": 6
    },
    {
      "type": "header",
      "content": "Text Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "EXPLORE OUR LATEST PRESS"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Dive into a world of media recognition, industry accolades, and behind-the-scenes glimpses into our brand's journey."
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read More Text",
      "default": "READ MORE"
    },
    {
      "type": "header",
      "content": "Footer Area"
    },
    {
      "type": "checkbox",
      "id": "show_footer_btn",
      "label": "Show View More Button",
      "default": true
    },
    {
      "type": "text",
      "id": "footer_btn_text",
      "label": "Button Label",
      "default": "VIEW MORE"
    },
    {
      "type": "url",
      "id": "footer_btn_link",
      "label": "Button Link",
      "info": "Leave blank to link to the selected blog."
    }
  ],
  "presets": [
    {
      "name": "Dynamic Blog Grid"
    }
  ]
}
{% endschema %}
