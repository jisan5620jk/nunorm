        },
            {
          "type": "text",
          "id": "heading2",
          "label": "Sub Text",
          "default": "Coming Soon"
        }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.email-signup-banner.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
