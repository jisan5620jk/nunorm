      $(".header").toggleClass("mob_header_intro");
      $('.mobile-drawer').addClass('open');
      $('.mobile-menu-overlay').fadeIn();
    });
    $('#mobile-search-button, #desktop-search-button').on('click', function () {
      $('#search-modal-content').addClass('open');
    });
    $("#search-modal-close-button").on('click', function() {
      $('#search-modal-content').removeClass("open")
    })

    $("#mobile-cart-button").on('click', function() {
      $('cart-drawer').addClass('active');
    })

    $('.drawer-close, .mobile-menu-overlay').on('click', function () {
      $('.mobile-drawer').removeClass('open');
      $('.mobile-menu-overlay').fadeOut();
    });

    $('.accordion-toggle').on('click', function () {
      const $toggle = $(this);
      const $submenu = $toggle.next('.submenu');
      const isOpen = $toggle.hasClass('open');
    
      // Close all
      $('.accordion-toggle').removeClass('open');
      $('.submenu').slideUp();
    
      // Open the clicked one
      if (!isOpen) {
        $toggle.addClass('open');
        $submenu.slideDown();
      }
    });
    
  });
</script>

                            
            

