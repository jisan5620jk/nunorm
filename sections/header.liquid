<script>
  document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll("details.mega-menu").forEach(function(menu) {
      const content = menu.querySelector(".mega-menu__content");

      function isDesktop() {
        return window.innerWidth >= 768;
      }

      // Initial state setup
      content.style.opacity = 0;
      content.style.transform = "translateY(-10px)";
      content.style.maxHeight = "0";
      content.style.transition = "opacity 0.3s ease, transform 0.3s ease, max-height 0.3s ease";
      content.style.overflow = "hidden";

      menu.addEventListener("mouseenter", function() {
        if (!isDesktop()) return;

        menu.setAttribute("open", "");

        // Force reflow before animation
        content.getBoundingClientRect();

        // Animate in
        content.style.opacity = 1;
        content.style.transform = "translateY(0)";
        content.style.maxHeight = content.scrollHeight + "px";
      });

      menu.addEventListener("mouseleave", function() {
        if (!isDesktop()) return;

        // Animate out
        content.style.opacity = 0;
        content.style.transform = "translateY(-10px)";
        content.style.maxHeight = "0";

        content.addEventListener("transitionend", function handler() {
          menu.removeAttribute("open");
          content.removeEventListener("transitionend", handler);
        });
      });

    });
  });
</script>



<script>
  document.addEventListener("DOMContentLoaded", function () {
    var triggerLink = document.getElementById("open-rewards");

    function openSmileWidget() {
      var smileButton = document.querySelector(".smile-improved-mobile-launcher");
      if (smileButton) {
        smileButton.click();
      }
    }

    if (triggerLink) {
      triggerLink.addEventListener("click", function (e) {
        e.preventDefault();
        openSmileWidget();
      });
    }

    // Optional: Open automatically if ?open=rewards is in URL
    const params = new URLSearchParams(window.location.search);
    if (params.get("open") === "rewards") {
      // Wait until Smile button is available
      const interval = setInterval(() => {
        if (document.querySelector(".smile-improved-mobile-launcher")) {
          clearInterval(interval);
          openSmileWidget();
        }
      }, 250);
    }
  });
</script>




