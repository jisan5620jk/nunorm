<style>
  .sh-wrapper {
    position: relative;
    width: 100%;
    min-height: 600px; /* Tall enough for the image */
    background-color: #193A4F; /* Deep Slate Blue */
    display: flex;
    align-items: end;
    overflow: hidden; /* Clips the absolute image if it's too wide */
    z-index: 1;
  }

  .sh-container {
    width: 100%;
    margin: 0 auto;
    padding: 60px;
    height: 100%;
    display: flex;
    align-items: center;
  }

  /* --- Bordered Box Styles --- */
  .sh-content-box {
    position: relative;
    z-index: 10; /* Ensures text is above image */
    width: 100%;
    max-width: 640px;
    background: #21334580;
    border: 4px solid #F7D3A1; /* Gold/Champagne Border */
    text-align: center;
    padding: 26px 20px 32px;
  }

  .sh-title {
    margin: 0 0 3px 0;
    line-height: 1.1;
  }

  .sh-text-primary {
    display: inline-block;
    color: #FBEEDA;
    font-family: Montserrat;
    font-weight: 800;
    font-size: 32px;
    line-height: 34px;
    letter-spacing: 0.6px;
    text-align: center;
    vertical-align: middle;
    text-transform: uppercase;
  }

  .sh-text-accent {
    display: inline-block;
    font-family: Montserrat;
    font-weight: 800;
    font-style: italic;
    font-size: 32px;
    line-height: 34px;
    letter-spacing: 0.6px;
    text-align: center;
    vertical-align: middle;
    text-transform: uppercase;
    color: #f7d3a1;
    margin-left: 4px;
  }

  .sh-description {
    font-family: Montserrat;
    font-weight: 400;
    font-size: 16px;
    line-height: 28px;
    letter-spacing: 0;
    text-align: center;
    vertical-align: middle;
    color: #FBEEDA;
    margin: 0 auto;
    width: 100%;
    max-width: 512px;
  }

  /* --- Absolute Image Styles --- */
  .sh-image-wrap {
    position: absolute;
    bottom: 0;
    right: 0;
    max-width: 840px;
    width: 100%;
    height: calc(100% - 18px);
    z-index: 1;
    pointer-events: none;
  }

  .sh-img {
    width: 100%;
    height: 100%;
    object-fit: contain; /* Keeps the person perfectly proportioned */
    object-position: bottom right; /* Anchors image to corner */
    display: block;
  }

  .sh-img.placeholder {
    object-fit: cover;
    opacity: 0.3;
  }

  /* --- Responsive Styles --- */
  @media (max-width: 990px) {
    .sh-wrapper {
      min-height: auto;
      flex-direction: column;
    }

    .sh-container {
      padding: 60px 16px 0;
      flex-direction: column;
      align-items: center;
    }

    .sh-content-box {
      padding: 30px 16px;
      text-align: center;
      margin-bottom: 50px;
    }

    .sh-image-wrap {
      position: relative;
      width: 100%;
      right: auto;
      bottom: auto;
    }

    .sh-img {
      object-position: bottom center;
    }
  }
</style>

<div class="sh-wrapper">
  <div class="sh-container">
    {% comment %} Left Content: Bordered Box {% endcomment %}
    <div class="sh-content-box">
      <h2 class="sh-title">
        <span class="sh-text-primary">{{ section.settings.title_primary }}</span>
        <span class="sh-text-accent">{{ section.settings.title_accent }}</span>
      </h2>
      <div class="sh-description">
        {{ section.settings.description }}
      </div>
    </div>

    {% comment %} Right Image: Position Absolute {% endcomment %}
    <div class="sh-image-wrap">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 1400 }}"
          loading="lazy"
          alt="{{ section.settings.title_primary }}"
          class="sh-img"
        >
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'sh-img placeholder' }}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Static Headline Banner",
  "settings": [
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "title_primary",
      "label": "Heading Part 1 (Sans-Serif)",
      "default": "IN THE"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Heading Part 2 (Serif Italic)",
      "default": "HEADLINES"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Welcome to our Press & PR hub, where we showcase the latest buzz surrounding our men's makeup revolution."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Image (Transparent PNG Recommended)"
    }
  ],
  "presets": [
    {
      "name": "Static Headline Banner"
    }
  ]
}
{% endschema %}
