{{ 'hero-bg-video.css' | asset_url | stylesheet_tag }}
<section class="hero-video-wrapper  {{ section.settings.custom_class }} {{ section.settings.text_position }} {% if section.settings.fix-bg %} fix-bg {% endif %}">
  <div
    class="hero-text-block"
    data-aos="fade-up"
    data-aos-duration="1800"
    style="color: {{ section.settings.text_color }}"
  >
    <h2
      class="hero-heading"
      style="font-size: {{ section.settings.heading_size_desktop }}px; color: {{ section.settings.heading_color }};"
    >
      {{ section.settings.heading | raw }}
    </h2>
    <p
      class="hero-subtext"
      style="font-size: {{ section.settings.subtext_size_desktop }}px; color: {{ section.settings.subtext_color }};"
    >
      {{ section.settings.subtext | raw }}
    </p>
    {% if section.settings.button_text != blank %}
      <a
        href="{{ section.settings.button_link }}"
        class="{{ section.settings.button_style }}"
      >
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
  {% if section.settings.media_type == 'video' and section.settings.video_url != blank %}
    <div class="hero-video-container ">
      <video class="hero-video-bg" autoplay loop muted playsinline>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
        Your browser does not support the video tag.
      </video>
      <button
        class="hero-video-toggle"
        aria-label="Pause background video"
        aria-pressed="false"
      >
        ❚❚
      </button>
    </div>
  {% elsif section.settings.media_type == 'image' and section.settings.image_bg != blank %}
    <div
      class="hero-image-container"
      {% if section.settings['fix-bg'] %}
        style="
          background-image: url('{{ section.settings.image_bg | image_url }}');
          background-size: calc(100% * var(--bg-zoom));
          background-attachment: fixed;
        "
      {% endif %}
    >
      <img
        src="{{ section.settings.image_bg | image_url: width: 1200 }}"
        alt="{{ section.settings.image_bg.alt | escape }}"
        class="hero-image-bg"
        loading="lazy"
        width=""
        height=""
        {% if section.settings['fix-bg'] %}
          style="display: none !important;"
        {% endif %}
      >
    </div>
  {% else %}
    <div class="hero-image-container fallback-bg"></div>
  {% endif %}
</section>

<style>
  /* Desktop: keep "fixed" feel */
  .hero-video-wrapper.fix-bg .hero-image-container {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 1;
    background-position: center center !important;
  }
  .hero-video-wrapper.fix-bg .hero-image-container::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--bg-url);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed; /* desktop only; see mobile override */
    transform: scale(var(--bg-zoom, 1));
    transform-origin: center center;
    will-change: transform;
    transition: transform 0.2s ease-out;
  }

  /* Mobile: disable background-attachment: fixed and rely on transforms only */
  @media (max-width: 767px) {
    .hero-video-wrapper.fix-bg .hero-image-container::before {
      background-attachment: scroll; /* iOS Safari fix */
      background-size: cover !important;
    }
    .hero-video-wrapper.fix-bg .hero-image-container{
      background-size: cover !important;
      background-position: center center !important;
    }
    /* Use small viewport height on mobile to avoid URL bar jumps */
    .hero-video-wrapper { height: 100svh; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video-wrapper.fix-bg .hero-image-container::before {
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<style>
  .hero-video-wrapper {
    position: relative;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 40px;
  }
  .hero-text-block {
    position: relative;
    z-index: 2;
  }
  .hero-heading {
    font-weight: bold;
    text-transform: uppercase;
  }
  .hero-subtext {
    margin-top: 20px;
  }
  .hero-button {
    display: inline-block;
    margin-top: 8px;
    padding: 14px 28px;
    text-decoration: none;
    font-weight: 600;
    border-radius: 6px;
    transition: background-color 0.3s ease;
  }
  .button-maroon {
    background-color: #953F2F;
    color: #FBEEDA;
  }
  .button-blue {
    background-color: #213345;
    color: #FBEEDA;
  }
  .button-tan {
    background-color: #FBEEDA;
    color: #FBEEDA;
  }
  .hero-video-container,
  .hero-image-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }
  .hero-image-bg,
  .hero-video-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .fallback-bg {
    background-color: #ccc;
  }
  .hero-video-toggle {
    position: absolute;
    bottom: 20px;
    right: 20px;
    background: rgba(0, 0, 0, 0.4);
    color: white;
    border: none;
    font-size: 24px;
    padding: 8px 12px;
    cursor: pointer;
    z-index: 3;
    width: 44px;
  }
  @media (max-width: 768px) {
    .hero-video-wrapper {
      padding: 20px;
      align-items: flex-end;
      min-height: 500px;
    }
    .hero-heading {
      font-size: {{ section.settings.heading_size_mobile }}px !important;
    }
    .hero-subtext {
      font-size: {{ section.settings.subtext_size_mobile }}px !important;
    }
  }
</style>

{% schema %}
