      ]
    }
  ],
  "presets": [
    {
      "name": "Hero with Video or Image"
    }
  ]
}
{% endschema %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    const containers = document.querySelectorAll('.hero-video-container');

    containers.forEach((container) => {
      const video = container.querySelector('.hero-video-bg');
      const button = container.querySelector('.hero-video-toggle');

      if (!video || !button) return;

      // Force mute and play on load (helps with iOS autoplay)
      video.muted = true;
      video.play().catch(() => {
        // If play fails, some browsers may delay it until interaction
        console.log('Autoplay prevented, will retry after user interaction');
      });

      button.addEventListener('click', () => {
        const isPaused = video.paused || video.ended;

        if (isPaused) {
          video.play();
          button.textContent = '❚❚';
          button.setAttribute('aria-label', 'Pause background video');
          button.setAttribute('aria-pressed', 'false');
        } else {
          video.pause();
          button.textContent = '▶';
          button.setAttribute('aria-label', 'Play background video');
          button.setAttribute('aria-pressed', 'true');
        }
      });
    });
  });
{% endjavascript %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Find every hero that has fixed-background mode enabled
    const heroes = document.querySelectorAll('.hero-video-wrapper.fix-bg');

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced || heroes.length === 0) return;

    const MAX_ZOOM = 2.25; // final zoom when the hero has fully traversed the viewport
    const EASE_POWER = 1.8;

    function progressThrough(el) {
      const r = el.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;

      // Total distance the viewport travels while the element is relevant:
      // from just before it enters (top == vh) until it's fully past (bottom == 0).
      // That's (element height + viewport height).
      const total = r.height + vh;

      // How much we've traversed so far:
      // when el.top == vh  -> traversed = 0  (not yet entered)
      // when el.top == 0   -> traversed = vh (top hits viewport)
      // when el.bottom == 0-> traversed = total (fully crossed)
      const traversed = Math.min(Math.max(vh - r.top, 0), total);

      return traversed / total; // 0 → 1 across the entire pass
    }

    // Per-hero handlers
    heroes.forEach((hero) => {
      const bgContainer = hero.querySelector('.hero-image-container');
      if (!bgContainer) return;

      let ticking = false;

      const update = () => {
        const p = progressThrough(hero); // 0 → 1 as the hero passes
        const eased = Math.pow(p, EASE_POWER); // ease the progress
        const scale = 1 + (MAX_ZOOM - 1) * eased; // 1 → MAX_ZOOM
        bgContainer.style.setProperty('--bg-zoom', scale.toFixed(4));
        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      };

      // Use IntersectionObserver to bind/unbind listeners efficiently,
      // but keep updating as long as the hero is around the viewport.
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              update();
              window.addEventListener('scroll', onScroll, { passive: true });
              window.addEventListener('resize', onScroll);
            } else {
              // Once it's fully crossed, lock at end state; otherwise reset if above.
              const rect = hero.getBoundingClientRect();
              if (rect.bottom <= 0) {
                // fully past the top edge: keep final zoom
                bgContainer.style.setProperty('--bg-zoom', MAX_ZOOM);
              } else {
                // not reached yet (or scrolled back above): reset
                bgContainer.style.setProperty('--bg-zoom', 1);
              }
              window.removeEventListener('scroll', onScroll);
              window.removeEventListener('resize', onScroll);
            }
          });
        },
        {
          // Small positive rootMargin keeps updates active slightly before/after edges
          root: null,
          threshold: 0,
          rootMargin: '100px 0px 100px 0px',
        }
      );

      io.observe(hero);
    });
  });
</script>
