{% style %}
  .learn-from-guys-section {
    padding: 80px 0 80px;
    background: linear-gradient(90deg, #F7D3A1 0%, #FBEEDA 100%);
  }

  .learn-from-guys {
    margin: 0 auto;
    text-align: center;
  }

  .learn-from-guys__title {
    margin: 0 0 15px;
    font-family: Montserrat;
    font-weight: 800;
    font-size: 32px;
    line-height: 145%;
    letter-spacing: 0.6px;
    text-align: center;
    vertical-align: middle;
    text-transform: uppercase;
  }

  .learn-from-guys__eyebrow {
    color: #7a1c20;
    font-style: italic;
  }

  .learn-from-guys__heading-main {
    color: #213346;
  }

  .learn-from-guys__subheading {
    max-width: 700px;
    margin: 0 auto 44px;
    font-family: Montserrat;
    font-weight: 400;
    font-size: 20px;
    line-height: 28px;
    letter-spacing: 0.6px;
    text-align: center;
    vertical-align: middle;
  }

  /* Swiper slider */
  .learn-from-guys__slider {
    margin-bottom: 49px;
  }

  .learn-from-guys__slider .swiper-slide {
    display: flex;
    justify-content: center;
  }

  .learn-from-guys__image-item {
    width: 100%;
    border-radius: 24px;
    overflow: hidden;
  }

  .learn-from-guys__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* Button */
  .learn-from-guys__button {
    display: inline-block;
    padding: 18.5px 25px;
    background-color: #933F2C;
    color: #FBEEDA;
    font-family: Montserrat;
    font-weight: 700;
    font-style: Bold;
    text-decoration: none;
    font-size: 18px;
    line-height: 100%;
    letter-spacing: 0;
    text-align: center;
    vertical-align: middle;
    text-transform: uppercase;
    border-radius: 10px;
    transition: transform 0.2s ease;
  }

  .learn-from-guys__button:hover {
    transform: translateY(-1px);
  }
  @media screen and (max-width: 419px) {
    .learn-from-guys__button {
        font-size: 14px;
    }
  }
{% endstyle %}

{%- comment -%} Load Swiper CSS once {%- endcomment -%}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<section id="section-{{ section.id }}" class="learn-from-guys-section" data-learn-from-guys>
  <div class="learn-from-guys">
    {% if section.settings.eyebrow_text != blank or section.settings.heading != blank %}
      <h2 class="learn-from-guys__title">
        {% if section.settings.eyebrow_text != blank %}
          <span class="learn-from-guys__eyebrow">{{ section.settings.eyebrow_text }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <span class="learn-from-guys__heading-main">{{ section.settings.heading }}</span>
        {% endif %}
      </h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="learn-from-guys__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% assign image_blocks = section.blocks | where: 'type', 'image' %}
    {% if image_blocks.size > 0 %}
      <div class="learn-from-guys__slider swiper" data-slider>
        <div class="swiper-wrapper">
          {% for block in image_blocks %}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <div class="learn-from-guys__image-item">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag: loading: 'lazy', class: 'learn-from-guys__image', alt: block.settings.alt_text
                  }}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}" class="learn-from-guys__button">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slider = document.querySelector(`#section-{{ section.id }} [data-slider]`);
    if (!slider || slider.swiper) return;

    if (!window.Swiper) {
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
      script.onload = init;
      document.head.appendChild(script);
    } else {
      init();
    }

    function init() {
      new Swiper(slider, {
        loop: true,
        speed: 800,
        centeredSlides: true,
        spaceBetween: 20,
        slidesPerView: 1.2,
        breakpoints: {
          640: {
            slidesPerView: 2.2,
            spaceBetween: 26,
          },
          1024: {
            slidesPerView: 3.2,
            spaceBetween: 32,
          },
          1200: {
            slidesPerView: 3.99,
            spaceBetween: 32,
          },
        },
      });
    }
  });
</script>

{% schema %}
{
  "name": "Learn from other guys",
  "settings": [
    { "type": "text", "id": "eyebrow_text", "label": "Eyebrow text (left part of heading)", "default": "LEARN FROM" },
    { "type": "text", "id": "heading", "label": "Main heading text", "default": "OTHER GUYS" },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading text",
      "default": "This is your about section paragraph. It's a great place to give a short introduction about what you do."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "EXPLORE OUR COMMUNITY PAGE" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt_text", "label": "Image alt text" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Learn from other guys",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
