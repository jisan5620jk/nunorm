</div>

</div>

</div>


<style>
.main_account_page_i
{
    padding-top:{{section.settings.padding_top}}px;
    padding-bottom:{{section.settings.padding_bottom}}px;
}
</style>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
<script>
$(document).ready(function(){
  $(".account_details_list").click(function(){
    $(".account_page_texts_one").addClass("active");
    $(".account_details_list").addClass("active");
    $(".oderse_list").removeClass("active");
    $(".account_page_texts_two").removeClass("active");
  });
});
</script>

<script>
$(document).ready(function(){
  $(".oderse_list").click(function(){
    $(".account_page_texts_one").removeClass("active");
    $(".account_page_texts_two").addClass("active");
    $(".account_details_list").removeClass("active");
    $(".oderse_list").addClass("active");
  });
});
</script>
<script type="text/javascript">
    function getUrlParameter(name) {
        name = name.replace(/[\[]/, "\\[").replace(/[\]]/, "\\]");
        var regex = new RegExp("[\\?&]" + name + "=([^&#]*)"),
        results = regex.exec(location.search);
        return results === null ? "" : decodeURIComponent(results[1].replace(/\+/g, " "));
    }
    var qsp = 'order',
        para = getUrlParameter(qsp);


    if(para)
      {
        $(".account_page_texts_one").removeClass("active");
        $(".account_page_texts_two").addClass("active");
        $(".account_details_list").removeClass("active");
        $(".oderse_list").addClass("active");
      }

 
</script>

{% schema %}
{
  "name": "t:sections.main-account.name",
  "class": "main_account_page_i",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}


