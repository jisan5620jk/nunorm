<style>
  .marquee-alert {
    overflow: hidden;
    width: 100%;
    padding: 13px 0;
  }

  .marquee-alert__inner {
    display: inline-block;
    white-space: nowrap;
    animation: marquee-scroll 35s linear infinite;
  }
  .marquee-alert__inner:hover {
    animation-play-state: paused;
    }

  .marquee-alert__text {
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    letter-spacing: 8px;
    text-transform: uppercase;
    margin: 0 20px;
    color: #FFF1DD;
  }

  @keyframes marquee-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
<section class="marquee-alert" style="background-color: {{ section.settings.bg_color }};">
  <div class="marquee-alert__inner">
    {% for block in section.blocks %}
      <span
        class="marquee-alert__text"
        style="
          color: {{ block.settings.text_color }};
          opacity: {{ block.settings.opacity }};
          font-weight: {{ block.settings.font_weight }};
        "
        {{ block.shopify_attributes }}
      >
        {{ block.settings.text }}
      </span>
    {% endfor %}
    {% for block in section.blocks %}
      <span
        class="marquee-alert__text"
        style="
          color: {{ block.settings.text_color }};
          opacity: {{ block.settings.opacity }};
          font-weight: {{ block.settings.font_weight }};
        "
        {{ block.shopify_attributes }}
      >
        {{ block.settings.text }}
      </span>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Marquee Alert",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#7A1C20"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Alert Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "GIVEAWAY ALERT"
        },
        {
          "type": "range",
          "id": "opacity",
          "label": "Opacity",
          "min": 0.1,
          "max": 1,
          "step": 0.1,
          "default": 1
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font weight",
          "default": "700",
          "options": [
            { "value": "400", "label": "Regular (400)" },
            { "value": "500", "label": "Medium (500)" },
            { "value": "600", "label": "Semi-Bold (600)" },
            { "value": "700", "label": "Bold (700)" },
            { "value": "800", "label": "Extra-Bold (800)" },
            { "value": "900", "label": "Black (900)" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Alert",
      "category": "Banners"
    }
  ]
}
{% endschema %}
