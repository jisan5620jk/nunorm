<div class="page-width">
  <div class="">
    <div class="nunorm-header__main">
      <div class="nunorm-header nunorm-header--center">
        {%- if section.settings.title != blank -%}
          <h2 class="title">{{ section.settings.title }}</h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- if section.settings.desc != blank -%}
          <p class="desc">{{ section.settings.desc }}</p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="mt-10">
            <a
              href="{{ section.settings.button_url }}"
              class="button"
              {% if section.settings.open_link_in_new_tab %}
                target="_blank"
              {% endif %}
            >
              {{- section.settings.button_label -}}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .nunorm-header .title{
    max-width: 580px;
    margin: 0px auto;
    color: #213345;
  }

  .nunorm-header .title em{
    color: #8C2A26;
  }

  .nunorm-header .desc{
    max-width: 1000px;
    margin: 0px auto;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "NuNorm Header",
  "class": "section section--nunorm-header section-animate",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "inline_richtext",
      "id": "desc",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Omit to hide the button"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "open_link_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "NuNorm Header"
    }
  ]
}
{% endschema %}
