{{ 'section-image-text-arrow-grid.css' | asset_url | stylesheet_tag }}

<!-- / our community / -->
<section class="our-community-outer layout">
  <!-- / heading sec / -->
  <div class="sec-heading page-width">
    <h2>{{ section.settings['sec-heading'] }}</h2>
    <p class="pera">{{ section.settings.pera }}</p>
  </div>

  <!-- / our-community list / -->
  <div class="our-community-inner">
    <!-- / 1 / -->
    <div class="our-community-list">
      <!-- / img people / -->
      <div class="img-box">
        <img loading="lazy" src="{{ section.settings.img1 | img_url: '1000x' }}" alt="{{ section.settings.img1.alt }}">
        {% if section.settings.img11 != blank %}
          <img
            loading="lazy"
            src="{{ section.settings.img11 | img_url: '1000x' }}"
            alt="{{ section.settings.img1.alt }}"
          >
        {% endif %}
      </div>

      <!-- / text-box / -->
      <div class="text-box">
        <!-- / name / -->
        <h3 class="ITAG_Card-header">{{ section.settings.name1 }}</h3>
        <p class="ITAG_Card-text" >{{ section.settings['detail-1'] }}</p>
      </div>
    </div>

    <!-- / 2 / -->
    <div class="our-community-list">
      <!-- / img people / -->
      <div class="img-box">
        <img loading="lazy" src="{{ section.settings.img2 | img_url: '1000x' }}" alt="{{ section.settings.img2.alt }}">
        {% if section.settings.img22 != blank %}
          <img
            loading="lazy"
            src="{{ section.settings.img22 | img_url: '1000x' }}"
            alt="{{ section.settings.img2.alt }}"
          >
        {% endif %}
      </div>

      <!-- / text-box / -->
      <div class="text-box">
        <!-- / name / -->
        <h3 class="ITAG_Card-header">{{ section.settings.name2 }}</h3>
        <p class="ITAG_Card-text" >{{ section.settings['detail-2'] }}</p>
      </div>
    </div>

    <!-- / 3 / -->
    <div class="our-community-list">
      <!-- / text-box / -->
      <div class="text-box">
        <!-- / name / -->
        <h3 class="ITAG_Card-header">{{ section.settings.name3 }}</h3>
        <p class="ITAG_Card-text" >{{ section.settings['detail-3'] }}</p>
      </div>

      <!-- / img people / -->
      <div class="img-box">
        <img loading="lazy" src="{{ section.settings.img3 | img_url: '1000x' }}" alt="{{ section.settings.img3.alt }}">
        {% if section.settings.img33 != blank %}
          <img
            loading="lazy"
            src="{{ section.settings.img33 | img_url: '1000x' }}"
            alt="{{ section.settings.img3.alt }}"
          >
        {% endif %}
      </div>
    </div>

    <!-- / 4 / -->
    <div class="our-community-list">
      <!-- / text-box / -->
      <div class="text-box">
        <!-- / name / -->
        <h3 class="ITAG_Card-header">{{ section.settings.name4 }}</h3>
        <p class="ITAG_Card-text" >{{ section.settings['detail-4'] }}</p>
      </div>

      <!-- / img people / -->
      <div class="img-box">
        <img loading="lazy" src="{{ section.settings.img4 | img_url: '1000x' }}" alt="{{ section.settings.img4.alt }}">
        {% if section.settings.img44 != blank %}
          <img
            loading="lazy"
            src="{{ section.settings.img44 | img_url: '1000x' }}"
            alt="{{ section.settings.img44.alt }}"
          >
        {% endif %}
      </div>
    </div>
  </div>
  <!-- / button / -->
  <center class="center-btn">
    <div class="button_gray">
      <span class="gray_button_circle"> </span>
      <a href="{{ section.settings.btn-link }}" class="button_gray_inner">
        <span class="button_text_container">
          {{ section.settings['btn-text'] }}
        </span>
      </a>
    </div>
  </center>
</section>

