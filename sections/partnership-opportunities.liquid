{% style %}
  .partnership-opps-section {
    padding: 74px 16px 80px;
    background: linear-gradient(90deg, #F7D3A1 0%, #FBEEDA 100%);
  }

  .partnership-opps {
    max-width: 1080px;
    margin: 0 auto;
    text-align: center;
  }

  /* Images row */
  .partnership-opps__images {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 24px;
  }

  .partnership-opps__image-item {
    overflow: hidden;
  }

  .partnership-opps__image {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  @media screen and (min-width: 768px) {
    .partnership-opps__images {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }

  @media screen and (min-width: 1024px) {
    .partnership-opps__images {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* Heading */
  .partnership-opps__heading {
    margin: 0 0 22px;
    font-family: Montserrat;
    font-weight: 800;
    font-size: 26px;
    line-height: 36px;
    letter-spacing: 0.6px;
    text-align: center;
    vertical-align: middle;
    text-transform: uppercase;
    color: #213346;
  }

  /* Tags / pills */
  .partnership-opps__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px;
    max-width: 560px;
    margin: 0 auto;
  }

  .partnership-opps__tag {
    background-color: #262626;
    color: #FBEEDA;
    padding: 15.5px 23.5px;
    border-radius: 14px;
    font-family: Montserrat;
    font-weight: 500;
    font-size: 12px;
    line-height: 100%;
    letter-spacing: 1.44px;
    text-align: center;
    vertical-align: middle;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media screen and (min-width: 768px) {
    .partnership-opps__heading {
      font-size: 32px;
      line-height: 48px;
    }
    .partnership-opps__tags {
        gap: 24px;
    }
  }
  @media screen and (max-width: 1023px) {
    .partnership-opps-section {
      padding: 0 16px 80px;
    }
  }
{% endstyle %}

<section id="section-{{ section.id }}" class="partnership-opps-section">
  <div class="partnership-opps">
    <div class="partnership-opps__images">
      {% for block in section.blocks %}
        {% if block.type == 'image' %}
          <div class="partnership-opps__image-item" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | img_url: '800x' }}"
                alt="{{ block.settings.alt_text | escape }}"
                loading="lazy"
                class="partnership-opps__image"
              >
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.heading != blank %}
      <h2 class="partnership-opps__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="partnership-opps__tags">
      {% for block in section.blocks %}
        {% if block.type == 'pill' %}
          <div class="partnership-opps__tag" {{ block.shopify_attributes }}>
            {{ block.settings.label }}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Partnership opportunities",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PARTNERSHIP OPPORTUNITIES"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image alt text"
        }
      ]
    },
    {
      "type": "pill",
      "name": "Opportunity tag",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tag label",
          "default": "Affiliate marketing"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Partnership opportunities",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        {
          "type": "pill",
          "settings": { "label": "AFFILIATE MARKETING" }
        },
        {
          "type": "pill",
          "settings": { "label": "GIFTING" }
        },
        {
          "type": "pill",
          "settings": { "label": "DISCOUNT CODES" }
        },
        {
          "type": "pill",
          "settings": { "label": "CAMPAIGNS" }
        },
        {
          "type": "pill",
          "settings": { "label": "CONTENT CREATION" }
        }
      ]
    }
  ]
}
{% endschema %}
