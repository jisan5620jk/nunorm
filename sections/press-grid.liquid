{{ 'section-press-grid.css' | asset_url | stylesheet_tag }}

<div
  style="--background-color: {{ section.settings.background_color }};
         --spacing-top: var(--spacing-vertical-{{ section.settings.padding_top }});
         --spacing-bottom: var(--spacing-vertical-{{ section.settings.padding_bottom }});
         --text-color: {{ section.settings.text_color }};
         "
  class="PR_container layout"
>
  <h2 class="PR_title">{{ section.settings.title }}</h2>
  <p class="PR_subtitle">
    {{ section.settings.subtitle }}
  </p>
  <div class="PR_content">
    {% for block in section.blocks %}
      <div class="PR_item">
        <div class="PR_image-wrapper">
          {% if block.settings.image != blank %}
            {% liquid
              assign alt = block.settings.image.alt | default: block.settings.image.alt | default: block.settings.image.filename | split: '.' | first
            %}
          {% if  block.settings.link != blank %} <a class="PR_image-link" target="_blank" rel="noopener noreferrer" href="{{block.settings.link}}" > {% endif %}
            {% if  block.settings.link != blank %}
              <span class="visually-hidden" >Opens in a new tab</span>
            {% endif %}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag: alt: alt, class: 'PR_image'
            }}
          {% if  block.settings.link != blank %} </a> {% endif %}
          {% endif %}
        </div>
          <h3 style="--text-color: {{ section.settings.text_color }};" class="PR_item-subtitle">{{ block.settings.subtitle }}</h3>
          <p  style="--text-color: {{ section.settings.text_color }};" class="PR_item-description">{{ block.settings.description }}</p>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
    "name": "Press Grid",
    "settings": [
        {
            "type": "color",
            "id": "background_color",
            "label": "Background Color",
            "default": "#ffffff"
        },
        {
            "type": "text",
            "id": "title",
            "label": "Section Title",
            "default": "In the Headlines: Explore Our Blog"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Section Subtitle",
          "default": "Our latest news and updates"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#4F5050"
        },
        {
            "type": "select",
            "id": "padding_top",
            "label": "Padding Top",
            "options": [
                {"value": "7", "label": "7"},
                {"value": "8", "label": "8"},
                {"value": "9", "label": "9"}
            ],
            "default": "7"
        },
        {
            "type": "select",
            "id": "padding_bottom",
            "label": "Padding Bottom",
            "options": [
                {"value": "1", "label": "1"},
                {"value": "8", "label": "8"},
                {"value": "9", "label": "9"},
                {"value": "10", "label": "10"}
            ],
            "default": "10"
        }
    ],
    "blocks": [
        {
            "type": "press-item",
            "name": "Press Item",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image",
                    "info": "Upload an image for this blog item"
                },
                {
                    "type": "text",
                    "id": "subtitle",   
                    "label": "Subtitle",
                    "default": "Subtitle Text"
                },
                {
                    "type": "html",
                    "id": "description",
                    "label": "Description",
                    "default": "Description text goes here."
                },
                {
                  "type": "url",
                  "id": "link",
                  "label": "Link"
                }
            ]
        }
    ],
    "presets": [
        {
            "category": "Grid",
            "name": "Press Grid"
        }
    ]
}
{% endschema %}