<div class="faq-tabs layout">
  <div class="faq-tabs__nav" style="max-width: 100%; overflow: hidden;">
    {% if section.settings.general_faqs != blank %}
      <button class="faq-tab-button active" data-tab="general">General</button>
    {% endif %}

    {% if product.metafields.custom.pdp_faqs != blank %}
      <button
        class="faq-tab-button {% unless section.settings.general_faqs != blank %}active{% endunless %}"
        data-tab="{{ product.handle | escape }}"
      >
        {% comment %} {{ product.title }} {% endcomment %}
        FREQUENTLY ASKED QUESTIONS
      </button>
    {% endif %}
  </div>

  <div class="faq-tabs__content">
    {% if section.settings.general_faqs != blank %}
      <div class="faq-tab-panel active" data-tab-panel="general">
        {% assign rt_html = section.settings.general_faqs %}

        {% assign _html = rt_html
          | replace: '<p><strong>', '<strong>'
          | replace: '</strong></p>', '</strong>'
          | replace: '<b>', '<strong>'
          | replace: '</b>', '</strong>'
        %}
        {% assign parts = _html | split: '<strong>' %}

        {% for part in parts %}
          {% if part contains '</strong>' %}
            {% assign q = part | split: '</strong>' | first | strip %}
            {% assign a = part | split: '</strong>' | last | strip %}
            {% if q != blank and a != blank %}
              <div class="faq-accordion">
                <button class="accordion-header" aria-expanded="false">
                  <span>{{ q }}</span>
                  <span class="chevron">...</span>
                </button>
                <div class="accordion-body">
                  {{ a }}
                </div>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if product.metafields.custom.pdp_faqs != blank %}
      <div
        class="faq-tab-panel {% unless section.settings.general_faqs != blank %}active{% endunless %}"
        data-tab-panel="{{ product.handle | escape }}"
      >
        {% assign rt_html = product.metafields.custom.pdp_faqs | metafield_tag %}

        {% assign _html = rt_html
          | replace: '<p><strong>', '<strong>'
          | replace: '</strong></p>', '</strong>'
          | replace: '<b>', '<strong>'
          | replace: '</b>', '</strong>'
        %}
        {% assign parts = _html | split: '<strong>' %}

        {% for part in parts %}
          {% if part contains '</strong>' %}
            {% assign q = part | split: '</strong>' | first | strip %}
            {% assign a = part | split: '</strong>' | last | strip %}
            {% if q != blank and a != blank %}
              <div class="faq-accordion">
                <button class="accordion-header" aria-expanded="false">
                  <span>{{ q }}</span>
                  <span class="chevron">...</span>
                </button>
                <div class="accordion-body">
                  {{ a }}
                </div>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% unless section.settings.general_faqs != blank or product.metafields.custom.pdp_faqs != blank %}
      <p>No FAQs added yet.</p>
    {% endunless %}
  </div>
</div>

<style>
  .faq-tabs__nav {
    display: flex;
    gap: 24px;
    margin-bottom: 32px;
    justify-content: center;
  }

  .faq-tab-button {
    background: none;
    border: none;
    cursor: pointer;
    font-family: Point Panther;
    font-size: 30px !important;
    letter-spacing: 2px !important;
    color: #213346 !important;
  }

  .faq-tab-button.active {
    border-bottom: none;
    font-weight: bold !important;
  }

  .faq-tab-panel { display: none; }
  .faq-tab-panel.active { display: block; }

  .faq-accordion {
    border-top: none;
    border-bottom: 1px solid var(--color-burgundy);
  }

  .accordion-header {
    font-family: 'Montserrat';
    color: var(--color-midnight);
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    font-size: 15px;
    line-height: 120%;
    padding: 20px 0px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: bold;
  }

  .accordion-header .chevron {
    transition: transform 0.3s ease;
  }

  .accordion-header.active .chevron {
    transform: rotate(180deg);
  }

  /* Your working animation */
  .accordion-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .accordion-body p {
    font-size: 15px;
    color: var(--color-midnight);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Tabs
    document.querySelectorAll('.faq-tab-button').forEach((btn) => {
      btn.addEventListener('click', function () {
        document.querySelectorAll('.faq-tab-button').forEach((b) => b.classList.remove('active'));
        document.querySelectorAll('.faq-tab-panel').forEach((p) => p.classList.remove('active'));

        btn.classList.add('active');
        document.querySelector(`[data-tab-panel="${btn.dataset.tab}"]`).classList.add('active');
      });
    });

    // Accordions
    document.querySelectorAll('.accordion-header').forEach((header) => {
      header.addEventListener('click', function () {
        header.classList.toggle('active');
        const body = header.nextElementSibling;
        if (body.style.maxHeight && body.style.maxHeight !== '0px') {
          body.style.maxHeight = '0px';
        } else {
          body.style.maxHeight = body.scrollHeight + 'px';
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "FAQ Tabs (Dynamic)",
  "tag": "section",
  "settings": [
    {
      "type": "richtext",
      "id": "general_faqs",
      "label": "General FAQs (richtext)",
      "info": "Use <strong>Bold</strong> for each question. The text after it becomes the answer."
    }
  ],
  "blocks": [],
  "presets": [{ "name": "FAQ Tabs (Dynamic)" }]
}
{% endschema %}
