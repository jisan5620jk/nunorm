  <div class="simple-text-wrapper layout">
    <h2 class="simple-text-headline">
      {{ section.settings.headline }}
    </h2>
    <div class="simple-text-subheadline" style="text-transform: none !important;">
  <strong>{{ section.settings.subheadline | escape }}</strong>
</div>
    <p class="simple-text-body" data-aos="fade-up" data-aos-duration="1500">
      {{ section.settings.body_text | newline_to_br }}
    </p>

    {% if section.settings.button_text != blank and section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}" class="simple-text-button">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>


<style>
  .simple-text-section {
    padding: 80px 20px;
    text-align: center;
  }

  .simple-text-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .simple-text-headline {
    font-size: 38px;
    color: #913A27;
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 10px;
    text-align: center;
  }

  .simple-text-subheadline {
    font-size: 24px;
    font-weight: 700;
    color: #213345;
    margin: 0px;
    text-align: center;
    text-transform: none !important;
  }

  .simple-text-body {
    font-size: 18px;
    line-height: 1.6;
    color: #213345;
    text-align: center;
    margin: 10px 0px;
}

  .simple-text-button {
    display: inline-block;
    padding: 12px 24px;
    background-color: #213345;
    color: #fff;
    text-decoration: none;
    border-radius: 6px;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .simple-text-button:hover {
    background-color: #101d2b;
  }
</style>

{% schema %}
{
  "name": "Simple Text",
  "tag": "section",
  "class": "simple-text",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "OUR MISSION"
    },
    {
      "type": "text",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Enhancement + Empowerment + Ease"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body Text",
      "default": "We want men to feel and look their best without any compromise. Our mission is to make makeup accessible, comfortable, and free of stigma—giving you the tools to enhance your natural features while staying true to yourself."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      
    }
  ],
  "presets": [
    {
      "name": "Simple Text Section"
    }
  ]
}
{% endschema %}
