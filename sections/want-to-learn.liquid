    <script>
    
    function openFullscreen(a) {
      var elem = document.getElementById(a);
      if (elem.requestFullscreen) {
        elem.requestFullscreen();
      } else if (elem.webkitRequestFullscreen) { /* Safari */
        elem.webkitRequestFullscreen();
      } else if (elem.msRequestFullscreen) { /* IE11 */
        elem.msRequestFullscreen();
      }
    }
</script>

 <script>
$(document).ready(function(){
   
   $(".video-box-section").hide();
    $("#ViewAll").show();
  $(".filter-custom-section .filter-btn").click(function(){
    $(".filter-custom-section .filter-btn.active").removeClass("active");
    $(this).addClass("active");

    $("#top-description").show();
    var data = $(this).attr("data-item");
    $(".video-box-section").hide();
    var data_description = $("#"+data).attr("data-description");
    $("#top-description").text(data_description);
    $("#"+data).show();
  });
 
   $(".filter-result-all").click(function(){
     $("#top-description").hide();
     $(".video-box-section").hide();
     $("#ViewAll").show();
     $(".filter-btn.active").removeClass("active");

  });
});
</script>   

{% schema %}
  {
    "name": "Want To Learn",
    "settings": [
      {
        "type": "text",
        "id": "sec-head",
        "label": "Heading"
      },
      {
        "type": "inline_richtext",
        "id": "content",
        "label": "Description"
      },
      {
        "type": "text",
        "id": "btn-1",
        "label": "LARGE PORES"
      },
      {
