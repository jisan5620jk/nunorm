{{ 'section-want-to-learn.css' | asset_url | stylesheet_tag }}


<section class="want-to-learn-sec layout">
  <div class="page-width">
   <!--/ heading /-->

    <h1 class="sec-heading" style="color:#213346;">{{ section.settings.sec-head }}</h1>
    <p class="pera-wrap">{{ section.settings.content }}</p>
    
  <div class="learn-video-outer">
{% if section.settings.custom-filter == true %}
<div class="filter-section">
<div class="filter-custom-section">
 <div class="inner-filter">
   <div class="filter-btn filter-btn-1" data-item="{{ section.settings.btn-1|remove:" " |split: '&'}}">{{ section.settings.btn-1 }}</div>
   <div class="filter-btn filter-btn-2" data-item="{{ section.settings.btn-2 |remove:" " |split: '&' }}">{{ section.settings.btn-2 }}</div>
   <div class="filter-btn filter-btn-3" data-item="{{ section.settings.btn-3 |remove:" " |split: '&'}}">{{ section.settings.btn-3 }}</div>
   <div class="filter-btn filter-btn-4" data-item="{{ section.settings.btn-4 |remove:" " |split: '&'}}">{{ section.settings.btn-4 }}</div>
   <div class="filter-btn filter-btn-5" data-item="{{ section.settings.btn-5|remove:" " |split: '&' }}">{{ section.settings.btn-5 }}</div>
   <div class="filter-btn filter-btn-6" data-item="{{ section.settings.btn-6|remove:" " |split: '&' }}">{{ section.settings.btn-6 }}</div>
 </div>	
  <div class="inner-filter">
   <div class="filter-btn filter-btn-7" data-item="{{ section.settings.btn-7 |remove:" " |split: '&'}}">{{ section.settings.btn-7 }}</div>
   <div class="filter-btn filter-btn-8" data-item="{{ section.settings.btn-8 |remove:" " |split: '&'}}">{{ section.settings.btn-8 }}</div>
   <div class="filter-btn filter-btn-9" data-item="{{ section.settings.btn-9 |remove:" " |split: '&'}}">{{ section.settings.btn-9 }}</div>
   <div class="filter-btn filter-btn-10" data-item="{{ section.settings.btn-10 |remove:" " |split: '&' }}">{{ section.settings.btn-10 }}</div>
   <div class="filter-btn filter-btn-11" data-item="{{ section.settings.btn-11 |remove:" " |split: '&'}}">{{ section.settings.btn-11 }}</div>
   <div class="filter-btn filter-btn-12" data-item="{{ section.settings.btn-12 |remove:" " |split: '&'}}">{{ section.settings.btn-12 }}</div>
 </div>	
</div>
{% comment %}<button class="filter-result-btn">VIEW RESULT</button> {% endcomment %}
<a class="filter-result-all">View all</a>
</div>
{% endif %}

<div id="top-description"></div>
      
{% for block in section.blocks %}
