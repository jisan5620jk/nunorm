      <div class="video-set">
   <!--         <img src="https://cdn.shopify.com/s/files/1/0758/3639/1698/files/Mask_group_81d458c1-eef8-48ac-85bd-c993ea35306b.png?v=1684998204">
        <span class="play"><img src="https://cdn.shopify.com/s/files/1/0758/3639/1698/files/paly.svg?v=1685001011"></span> -->
        <!--/vedio/-->
     
          <!--/ play pause button  /-->
        <div class="play-pause-btn"> 
        <button class="PP-btn play_btn"  type="button" id="wtl-play-btn-loop1-{{ forloop.index }}"><img src="https://cdn.shopify.com/s/files/1/0727/3594/9103/files/play-btn.svg?v=1677224169"></button>
        <button class="PP-btn pause_btn" type="button" id="wtl-pause-btn-loop1-{{ forloop.index }}" style="display:none;"><img src="https://cdn.shopify.com/s/files/1/0727/3594/9103/files/pause-btn.svg?v=1677224169"></button>
      </div>
       <video loop autoplay muted class="small-hide" id="wtl-loop-Video1-{{ forloop.index }}" width="100%" height="463px" playsinline>
         <source type="video/mp4" src="{{ product.metafields.custom.video_url.value }}"></source>
         
       </video>
              <button onclick="openFullscreen('wtl-loop-Video1-{{ forloop.index }}');" id="full-src-Video-{{ forloop.index }}" class="video-full-screen"><img src="https://cdn.shopify.com/s/files/1/0758/3639/1698/files/full-screen.png?v=1704274560" width="24" height="24"/></button>
       <img class="loop-img" id="wtl-loop-banner-bg1-{{ forloop.index }}" src="{{ product.metafields.custom.video_image.value | img_url: 'master' }}" alt="{{ product.metafields.custom.video_image.value.alt }}">
      
   
      <script>
      $(document).ready(function(){
     
      var vid1 = document.getElementById("wtl-loop-Video1-{{ forloop.index }}");
      $("#wtl-play-btn-loop1-{{ forloop.index }}").click(function(){
       vid1.play(); 
      $("#full-src-Video-{{ forloop.index }}").css('display','block');
      $("#wtl-loop-Video1-{{ forloop.index }}").show();
      $("#wtl-loop-banner-bg1-{{ forloop.index }}").hide();
      $("#wtl-pause-btn-loop1-{{ forloop.index }}").show();
      $("#wtl-play-btn-loop1-{{ forloop.index }}").hide();
     
     
        });
        $("#wtl-pause-btn-loop1-{{ forloop.index }}").click(function(){
        $("#wtl-loop-Video1-{{ forloop.index }}").hide();
        $("#wtl-loop-banner-bg1-{{ forloop.index }}").show();
        $("#wtl-pause-btn-loop1-{{ forloop.index }}").hide();
        $("#wtl-play-btn-loop1-{{ forloop.index }}").show(); 
        vid1.pause();
        $("#full-src-Video-{{ forloop.index }}").css('display','none');
        });
      });
      </script>
      <script>
      $(document).ready(function(){
        $("#wtl-loop-Video1-{{ forloop.index }}").hide();
        $("#pause-btn").hide();
         $("#full-src-Video-{{ forloop.index }}").css('display','none');
      });
      </script>
            
            
          </div>
