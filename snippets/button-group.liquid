<style>
  .buttons--wrapper {
    width: 100%;
    margin: 0 !important;
    padding-top: 0;
  }

  .benefits-box {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    margin-top: 10px;
    margin-bottom: 10px;
  }

  .benefit-item {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .benefit-item p {
    margin: 0;
    color: #000;
    font-size: 8px;
    font-weight: 400;
    line-height: 13.2px;
    text-align: left;
  }

  .benefit-item strong {
    font-weight: 700;
  }

  span.checkmark {
    display: flex;
    color: #953F2F;
    width: 14px;
  }

  button#subscribe-checkout-btn {
    text-transform: unset;
    display: flex;
    justify-content: space-between;
    gap: 8px;
    align-items: center;
    width: 100%;
    min-height: 60px;
    background: #953F2F;
    color: #fff;
    font-family: 'Montserrat';
    color: #fbeeda;
    font-weight: 600;
    font-size: 14px;
  }

    button#subscribe-checkout-btn span {
    display: flex;
    pointer-events: none;
    margin: 0;
  }




  button#subscribe-checkout-btn:hover{
    color: #213346 !important;
  }

  #subscribe-checkout-btn::after,
  #subscribe-checkout-btn::before {
    display: none;
  }


  .sub--btn-price {
    margin-left: auto;
    font-weight: 600 !important;
    font-size: 18px !important;

  }

  #subscribe-checkout-btn.loading {
    opacity: 0.7;
    pointer-events: none;
    position: relative;
  }

  #subscribe-checkout-btn.loading::after {
    content: '';
    position: absolute;
    right: 12px;
    width: 14px;
    height: 14px;
    border: 2px solid #fff;
    border-top-color: transparent;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

{% assign total_subscriber_price = 0 %}
{% assign selling_plan_map = '' %}

{%- for item in cart.items -%}
  {% if item.product.selling_plan_groups.size > 0 %}
    {% assign selling_plan = item.product.selling_plan_groups[1].selling_plans | first %}
    {% assign price_adjustments = selling_plan.price_adjustments %}
    {% assign first_adjustment = price_adjustments[0] %}
    {% assign discount = item.final_price | times: first_adjustment.value | divided_by: 100 %}
    {% assign discounted_price = item.final_price | minus: discount %}
    {% assign line_total = discounted_price | times: item.quantity %}
    {% assign total_subscriber_price = total_subscriber_price | plus: line_total %}
  {% endif %}
{% endfor %}

<div class="buttons--wrapper">
  <button
    id="subscribe-checkout-btn"
    class="btn-primary cart__checkout-button button subscription--btn"
    name="checkout"
    {% if cart == empty %}
      disabled
    {% endif %}
  >
    <span>Save with a Subscription</span>
    <span class="sub--btn-price">
      {{- total_subscriber_price | money }}
      {% render 'icon-angle-arrow' -%}
    </span>
  </button>
  <div class="benefits-box">
    {% for i in (1..4) %}
      {% assign setting_key = 'subscription_benefits_text_' | append: i %}
      {% assign text = settings[setting_key] %}
      {% if text != blank %}
        <div class="benefit-item">
          <span class="checkmark">
            {% render 'icon-checkmark', class: 'icon-checkmark--small' %}
          </span>
          <p>{{ text }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>
