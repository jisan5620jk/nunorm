{% comment %}
  Renders cart drawer
  Usage: {% render 'cart-drawer' %}
{% endcomment %}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
    width: 100%;
  }
  .gfgCartPageWrapperV2 {
    margin: 0;
    opacity: 0;
  }

  .free-shipping-bar {
    padding: 6px 1.5rem;
    text-align: center;
    margin-bottom: 6px;
    font-family: inherit;
    border-bottom: 1px solid #edcfbb;
  }

  .progress-wrapper {
    position: relative;
    height: 8px;
    background: #f5d8c0;
    border-radius: 8px;
    margin-bottom: 1.4rem;
    display: flex;
    align-items: center;
  }

  .progress-bar {
    height: 8px;
    background: #b7412f;
    width: 0;
    transition: width 0.4s ease;
    border-radius: 25px;
  }

  .progress-icons {
    position: absolute;
    width: 100%;
    display: flex;
    justify-content: space-between;
  }

  .progress-icon {
    background: #fff;
    border: 2px solid #b7412f;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #b7412f;
    font-size: 18px;
    padding: 4px;
  }
  span.progress-icon img {
    width: 100%;
  }
  .free-shipping-text {
    font-size: 14px;
    color: #213346;
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 8px;
    align-items: center;
  }

  .free-shipping-text strong {
    display: block;
    font-size: 16px;
    color: #1f2937;
  }
  .remaining-amount {
    font-weight: 400;
    color: #1f2937;
    min-height: 18px;
    display: block;
  }
  .text h6 {
    margin: 0;
    font-size: 12px;
    text-align: left;
    letter-spacing: 0;
  }
  .text p {
    margin: 0;
    font-size: 10px;
    text-align: left;
    letter-spacing: 0;
  }

  .drawer__close svg {
    height: 3rem !important;
    width: 3rem !important;
    background: #fff;
    padding: 6px;
    border-radius: 2px;
  }

  h6.drawer__heading {
    font-size: 18px;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  h6.drawer__heading.heading-count span {
    width: 24px;
    height: 24px;
    background: #000;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    color: #fff;
    font-size: 14px;
    line-height: 18px;
  }

  .cart-drawer .cart-item__details {
    width: auto;
    grid-column: 2 / 5;
  }

  .product-card-item-head {
    display: grid;
    width: 100%;
    max-width: 100%;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    grid-template-columns: 1fr 30px;
  }

  .cart-item__final-price.product-option {
    font-size: 16px;
    font-weight: 700;
  }

  .cart-drawer .cart-item {
    display: grid;
    gap: 10px !important;
    margin-bottom: 14px !important;
    grid-template-columns: 90px 1fr max-content !important;
  }

  .cart-drawer .cart-item__media {
    width: 100% !important;
  }

  @media screen and (min-width: 750px) {
    .cart-item cart-remove-button {
      margin: 0 !important;
      justify-content: flex-end !important;
    }
    cart-remove-button .button {
      min-width: 1.8rem !important;
      min-height: 1.8rem !important;
    }
    cart-remove-button .button svg {
      width: 1.8rem !important;
      height: 1.8rem !important;
    }
  }

  .cart-drawer .cart-items .cart-item__quantity {
    padding-top: 0;
    grid-column: unset;
    padding-left: 0 !important;
  }

  .cart-item__quantity-wrapper {
    display: flex;
    align-items: center;
    gap: 20px;
    justify-content: space-between !important;
  }

  .product-option {
    line-height: unset !important;
  }

  .quantity {
    display: grid !important;
    grid-template-columns: 40px 40px 40px !important;
    width: max-content !important;
    min-height: 32px !important;
  }

  quantity-input.quantity.cart-quantity > * {
    max-height: 32px;
    background: #fff;
  }
  .drawer__inner {
    height: 100%;
    width:  !important;
  }
  div#CartDrawer-CartItems .cart-item img.cart-item__image {
    border-radius: 6px;
  }
  .product-card-item-head a {
    font-style: italic;
    font-size: 12px !important;
  }
  .drawer.active .drawer__inner {
    padding: 0;
  }

  .drawer__header {
    padding: 8px 1.5rem !important;
    border-bottom: 1px solid #edcfbb;
    margin-bottom: 12px;
  }

  .cart-drawer__form {
    padding: 0 1.5rem 1.5rem !important;
  }
  .drawer__close {
    right: 10px !important;
    top: 4px !important;
  }

  .drawer__footer {
    background-color: #fff !important;
    border-top: none !important;
    padding: 1.5rem !important;
  }

  .cart-drawer .cart__checkout-button {
    max-width: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    border-radius: 8px;
    font-weight: 400;
    gap: 10px;
    line-height: 1;
    font-size: 14px;
    text-transform: capitalize;
  }
  .cart-drawer .cart__checkout-button {
    font-size: 14px !important;
    background: linear-gradient(0deg, #fff9f0, #fff1dd);
    color: #000;
  }
  .totals__subtotal-value {
    font-size: 1.8rem;
    font-weight: 600;
  }

  .drawer__footer .cart__ctas .footer-bottom-content {
    display: flex;
    align-items: center;
    gap: 6px;
    justify-content: center;
    margin-top: 6px !important;
  }

  .footer-bottom-content .icon {
    height: 20px;
  }
  .footer-bottom-content .content {
    line-height: 1;
    font-size: 14px;
    letter-spacing: 0;
  }

  .totals__subtotal-value {
    font-size: 18px !important;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  s.cart-item__old-price.product-option {
    font-size: 12px;
  }
  .gfgPageWrapper.gfgCartPageWrapperV2.gfgUnifiedDiscountWrapper {
    display: none !important;
  }
  button.cart__checkout-button.button.main-button_bg {
    background: #213246 !important;
    color: #fbeeda;
    justify-content: center;
    font-weight: 600;
    text-transform: uppercase;
    margin-top: 24px;
    transition: all 0.3s ease;
  }
  button.cart__checkout-button.button.main-button_bg:hover {
    background: #ffff !important;
    color: #213246 !important;
    box-shadow: inset 0 0 6px 1px #21324611;
    transition: all 0.3s ease;
  }

  .totals__subtotal-title {
    font-size: 18px;
    text-transform: capitalize;
    margin: 0;
    font-weight: 700;
  }

  .totals__subtotal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }
  cart-drawer-items {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .cart-item__details > * + * {
    margin-top: 4px;
  }
  .cart-drawer .cart-item:last-child {
    margin-bottom: 0 !important;
  }

  button#CartDrawer-Checkout {
    padding: 0 2.3rem;
    margin: 0;
    font-family: 'Montserrat';
    font-weight: 600;
  }
  p.cart__empty-text {
    font-size: 26px;
    font-weight: 700;
    max-width: calc(100% - 50px);
    margin: auto auto 2.5rem;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0 !important;
  }
  .cart__login-title {
    margin: 3rem 0 0 !important;
    font-size: 22px !important;
    font-weight: 600 !important;
    letter-spacing: 0 !important;
  }
  a.button.cart__continue-shopping-button {
    /* height: 64px; */
    font-weight: 700;
    font-size: 16px;
    border-radius: 8px;
    text-transform: uppercase;
  }
  .cart__login-paragraph {
    margin-top: 0 !important;
    letter-spacing: 0;
  }
  .cart__login-paragraph a {
    letter-spacing: 0;
  }

  /* Free Gift Badge Style */
  .free-gift-badge {
    color: #22c55e;
    font-weight: 600;
    font-size: 16px;
  }
  span.cart-count {
    position: absolute;
    background: #FBEEDB;
    font-size: 10px;
    width: 16px;
    height: 16px;
    color: #213346;
    border-radius: 50%;
    bottom: -8px;
    font-weight: 700;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media screen and (max-width: 767px) {
    .drawer__inner {
      padding: 0 !important;
      max-width: 100% !important;
      width: 100% !important;
    }
    .drawer__header {
      padding: 8px 1.5rem !important;
      margin-bottom: 10px;
    }
    .progress-wrapper {
      margin-bottom: 1.3rem;
    }
    .drawer {
      width: 100% !important;
    }
    div#CartDrawer {
      width: 100%;
    }
  }
  .cart__ctas > *:not(noscript:first-child) + * {
    margin-top: 0 !important;
  }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  {% assign has_subscription_selected = false %}
  {% assign has_subscription_available = false %}

  {% for item in cart.items %}
    {% if item.selling_plan_allocation %}
      {% assign has_subscription_selected = true %}
    {% endif %}

    {% if item.product.selling_plan_groups.size > 0 %}
      {% assign has_subscription_available = true %}
    {% endif %}
  {% endfor %}
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="cart-drawer__warnings center{% if settings.cart_drawer_collection != blank %} cart-drawer__warnings--has-collection{% endif %}">
            <div class="cart-drawer__empty-content">
              <p class="cart__empty-text">{{ 'sections.cart.empty' | t }}</p>
              <button
                class="drawer__close"
                type="button"
                onclick="this.closest('cart-drawer').close()"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                {% render 'icon-close-2' %}
              </button>
              <a
                href="https://www.nunorm.com/collections/products"
                class="button cart__continue-shopping-button  btn-primary"
              >
                {{ 'general.continue_shopping' | t }}
              </a>
              {%- if shop.customer_accounts_enabled and customer == null -%}
                <p class="cart__login-title">{{ 'sections.cart.login.title' | t }}</p>
                <p class="cart__login-paragraph">
                  {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
                </p>
              {%- endif -%}
            </div>
          </div>
          {%- if settings.cart_drawer_collection != blank -%}
            {{ 'component-card.css' | asset_url | stylesheet_tag }}
            <div class="cart-drawer__collection">
              {% render 'card-collection', card_collection: settings.cart_drawer_collection, columns: 1 %}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="drawer__header">
        <div>
          <h6 class="drawer__heading heading-count">
            {{ 'sections.cart.title' | t }}
            <span>{{ cart.item_count }}</span>
          </h6>
          <button
            class="drawer__close"
            type="button"
            onclick="this.closest('cart-drawer').close()"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {% render 'icon-close-2' %}
          </button>
        </div>
      </div>
      {% if cart != empty %}
        <div class="free-shipping-progress">
          <div class="free-shipping-bar">
            <div class="progress-wrapper">
              <div class="progress-bar"></div>
              <div class="progress-icons">
                <span></span>
                <span class="progress-icon truck">
                  <img
                    src="{{ settings.progress_free_shipping_image | image_url: width: 30, height:30  }}"
                    alt=""
                    width="30"
                    height="30"
                  >
                </span>
                <span class="progress-icon gift">
                  <img
                    src="{{ settings.progress_free_gift_image | image_url: width: 30, height:30  }}"
                    alt=""
                    width="30"
                    height="30"
                  >
                </span>
              </div>
            </div>
            <div class="free-shipping-text">
              <div class="check-icon">{% render 'icon-circle-check' %}</div>
              <div class="text">
                <h6 class="progress-title-text">Wait! Never pay for shipping.</h6>
                <p>
                  <span class="remaining-amount"></span>
                </p>
              </div>
            </div>
          </div>
        </div>
      {% endif %}
      <cart-drawer-items
        {% if cart == empty %}
          class="is-empty"
        {% endif %}
      >
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
        >
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <div class="drawer__cart-items-wrapper">
                <div class="cart-items" role="table">
                  <div role="rowgroup">
                    {%- for item in cart.items -%}
                      {%- assign is_free_gift = false -%}
                      {%- if item.properties._free_gift == 'true' -%}
                        {%- assign is_free_gift = true -%}
                      {%- endif -%}

                      <div
                        id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                        class="cart-item {% if is_free_gift %}free-gift-item{% endif %}"
                        role="row"
                      >
                        <div
                          class="cart-item__media"
                          role="cell"
                          headers="CartDrawer-ColumnProductImage"
                        >
                          {% if item.image %}
                            {% unless item.product.type == 'Sample' or is_free_gift %}
                              <a
                                href="{{ item.url }}"
                                class="cart-item__link"
                                tabindex="-1"
                                aria-hidden="true"
                              ></a>
                            {% endunless %}
                            <img
                              class="cart-item__image"
                              src="{{ item.image | image_url: width: 300 }}"
                              alt="{{ item.image.alt | escape }}"
                              loading="lazy"
                              width="150"
                              height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                            >
                          {% endif %}
                        </div>

                        <div
                          class="cart-item__details"
                          role="cell"
                          headers="CartDrawer-ColumnProduct"
                        >
                          {%- if settings.show_vendor -%}
                            <p class="caption-with-letter-spacing light">{{ item.product.vendor }}</p>
                          {%- endif -%}

                          <div class="product-card-item-head">
                            {% unless item.product.type == 'Sample' or is_free_gift %}
                              <a
                                href="{{ item.url }}"
                                data-id="#CartDrawer-Remove-{{ forloop.index }}"
                                class="cart-item__name h4 break"
                                variant-id=".product-option-{{ forloop.index }}"
                              >
                                {{- item.product.title | escape -}}
                              </a>
                            {% else %}
                              <a
                                href="{{ item.url }}"
                                data-id="#CartDrawer-Remove-{{ forloop.index }}"
                                class="cart-item__name h4 break"
                                variant-id=".product-option-{{ forloop.index }}"
                              >
                                {{- item.product.title | escape -}}
                              </a>
                            {% endunless %}
                            <cart-remove-button
                              id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                              data-index="{{ item.index | plus: 1 }}"
                            >
                              <button
                                type="button"
                                class="button button--tertiary"
                                aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}"
                              >
                                {% render 'icon-remove-2' %}
                              </button>
                            </cart-remove-button>
                            {% comment %} {% unless is_free_gift %} {% endunless %} {% endcomment %}
                          </div>

                          {%- if item.product.has_only_default_variant == false
                            or item.properties.size != 0
                            or item.selling_plan_allocation != null
                          -%}
                            <dl>
                              {%- if item.product.has_only_default_variant == false -%}
                                {%- for option in item.options_with_values -%}
                                  <div
                                    class="product-option product-option-{{ forloop.index }}"
                                    data-value="{{ option.value }}"
                                  >
                                    <dt>{{ option.name }}:</dt>
                                    <dd>
                                      {{ option.value -}}
                                      {%- unless forloop.last -%}
                                        ,
                                      {% endunless %}
                                    </dd>
                                  </div>
                                {%- endfor -%}
                              {%- endif -%}

                              {%- for property in item.properties -%}
                                {%- assign property_first_char = property.first | slice: 0 -%}
                                {%- if property.last != blank and property_first_char != '_' -%}
                                  <div class="product-option">
                                    <dt>{{ property.first }}:</dt>
                                    <dd>
                                      {%- if property.last contains '/uploads/' -%}
                                        <a
                                          href="{{ property.last }}"
                                          class="link"
                                          target="_blank"
                                          aria-describedby="a11y-new-window-message"
                                        >
                                          {{ property.last | split: '/' | last }}
                                        </a>
                                      {%- else -%}
                                        {{ property.last }}
                                      {%- endif -%}
                                    </dd>
                                  </div>
                                {%- endif -%}
                              {%- endfor -%}
                            </dl>
                            <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                          {%- endif -%}

                          <ul
                            class="discounts list-unstyled"
                            role="list"
                            aria-label="{{ 'customer.order.discount' | t }}"
                          >
                            {%- for discount in item.discounts -%}
                              <li class="discounts__discount">
                                {%- render 'icon-discount' -%}
                                {{ discount.title }}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>

                        {% unless item.product.type == 'Sample' %}
                          <div
                            class="cart-item__quantity"
                            role="cell"
                            headers="CartDrawer-ColumnQuantity"
                          >
                            <div class="cart-item__quantity-wrapper">
                              <quantity-input class="quantity cart-quantity">
                                <button
                                  class="quantity__button no-js-hidden"
                                  name="minus"
                                  type="button"
                                >
                                  <span class="visually-hidden">
                                    {{-
                                      'products.product.quantity.decrease'
                                      | t: product: item.product.title
                                      | escape
                                    -}}
                                  </span>
                                  {% render 'icon-minus' %}
                                </button>
                                <input
                                  class="quantity__input"
                                  type="number"
                                  data-quantity-variant-id="{{ item.variant.id }}"
                                  name="updates[]"
                                  value="{{ item.quantity }}"
                                  data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                  min="{{ item.variant.quantity_rule.min }}"
                                  {% if item.variant.quantity_rule.max != null %}
                                    max="{{ item.variant.quantity_rule.max }}"
                                  {% endif %}
                                  step="{{ item.variant.quantity_rule.increment }}"
                                  aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                  id="Drawer-quantity-{{ item.index | plus: 1 }}"
                                  data-index="{{ item.index | plus: 1 }}"
                                >
                                <button
                                  class="quantity__button no-js-hidden"
                                  name="plus"
                                  type="button"
                                >
                                  <span class="visually-hidden">
                                    {{-
                                      'products.product.quantity.increase'
                                      | t: product: item.product.title
                                      | escape
                                    -}}
                                  </span>
                                  {% render 'icon-plus' %}
                                </button>
                              </quantity-input>

                              {%- if item.original_price != item.final_price -%}
                                <div class="cart-item__discounted-prices">
                                  <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                                  <s class="cart-item__old-price product-option">{{- item.original_price | money -}}</s>
                                  <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                                  <strong class="cart-item__final-price product-option">
                                    {{- item.final_price | money -}}
                                  </strong>
                                </div>
                              {%- else -%}
                                <div class="cart-item__final-price product-option">
                                  {{ item.original_price | money }}
                                </div>
                              {%- endif -%}
                            </div>
                          </div>
                        {% else %}
                          {% if is_free_gift %}
                            <div class="cart-item__quantity" role="cell">
                              <div class="cart-item__quantity-wrapper">
                                <span class="free-gift-badge">FREE</span>
                              </div>
                            </div>
                          {% endif %}
                        {% endunless %}
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
            <p
              id="CartDrawer-LiveRegionText"
              class="visually-hidden"
              role="status"
            ></p>
            <p
              id="CartDrawer-LineItemStatus"
              class="visually-hidden"
              aria-hidden="true"
              role="status"
            >
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
          {% comment %} <div id="CartDrawer-CartErrors" role="alert"></div> {% endcomment %}
        </form>
        {% if has_subscription_available == true and has_subscription_selected == false %}
          {%- render 'upsell-product-slider', cart: cart -%}
        {% endif %}
      </cart-drawer-items>
      {% if has_subscription_available == true and has_subscription_selected == false %}
      {% else %}
        {%- render 'upsell-product-slider', cart: cart -%}
      {% endif %}
      {%- unless cart == empty -%}
        <div class="drawer__footer">
          {% if has_subscription_available == true and has_subscription_selected == false %}
            <div class="cart__ctas" {{ block.shopify_attributes }}>
              {%- render 'button-group', cart: cart -%}
            </div>
          {% else %}
            <div class="cart-drawer__footer" {{ block.shopify_attributes }}>
              <div class="totals" role="status">
                <div class="totals__subtotal">
                  <p class="totals__subtotal-title">{{ 'sections.cart.subtotal' | t }}:</p>
                  <div class="totals__subtotal-value">
                    {% if cart.total_discount > 0 %}
                      <s class="cart-item__old-price product-option">-{{ cart.total_discount | money }}</s>
                    {% endif %}
                    {{ cart.total_price | money }}
                  </div>
                </div>
              </div>
            </div>
          {% endif %}

          <div class="cart__ctas" {{ block.shopify_attributes }}>
            <button
              type="submit"
              id="CartDrawer-Checkout"
              class="cart__checkout-button button {% if has_subscription_available == true and has_subscription_selected == false %}{% else %}main-button_bg{% endif %}"
              name="checkout"
              form="CartDrawer-Form"
              onClick="sampleFunction()"
              {% if cart == empty %}
                disabled
              {% endif %}
            >
              {% if has_subscription_available == true and has_subscription_selected == false %}
                Continue with One-Time
                <p class="totals__subtotal-value">
                  {{ cart.total_price | money -}}
                  {%- render 'icon-angle-arrow' %}
                </p>
              {% else %}
                {% render 'icon-cart-2' %} Check Out
              {% endif %}
            </button>
            <div class="footer-bottom-content">
              <div class="icon">{% render 'icon-star-4_5' %}</div>
              <div class="content">
                4.5/5 Excellent
                <strong>5000+ reviews</strong>
              </div>
            </div>
          </div>
        </div>
      {%- endunless -%}
    </div>
  </div>
</cart-drawer>
