<div class="products-toolbar">
  <div class="product-count-label"><span id="product-count">45</span> products</div>
  <button id="mobile-filters-toggle" class="filter-toggle-btn">Filter <span class="plus-icon">+</span></button>
</div>
<aside class="collection-filters w-full lg:w-[15%] px-4 space-y-6">
  <form id="collection-filters-form" class="space-y-6">
    {% if section.settings.show_sort %}
      <div class="filter-block border rounded overflow-hidden">
        <button
          type="button"
          class="filter-accordion-toggle w-full text-left py-3 px-4 bg-[#c96b3b] text-white font-bold"
        >
          Sort By...
        </button>
        <div
          class="filter-accordion-content p-4 bg-white max-h-0 overflow-hidden transition-all duration-300"
          id="sort-options"
        >
          <!--
            {% assign sort_options =
              "title-ascending|Alphabetical A-Z,
              title-descending|Alphabetical Z-A,
              price-ascending|Price: Low to High,
              price-descending|Price: High to Low,
              created-descending|Newest Arrivals" | split: "," %}

            {% for option in sort_options %}
              {% assign parts = option | split: "|" %}
              <label class="block mb-2">
                <input type="radio" name="sort_by" value="{{ parts[0] | strip }}" class="mr-2">
                {{ parts[1] | strip }}
              </label>
            {% endfor %}
          -->
        </div>
      </div>
    {% endif %}

    <!-- Shade Filter Section -->
    {% if section.settings.show_shade %}
      <div class="filter-block border rounded overflow-hidden">
        <button
          type="button"
          class="filter-accordion-toggle w-full text-left py-3 px-4 bg-[#c96b3b] text-white font-bold"
        >
          Filter By Shade
        </button>
        <div
          class="filter-accordion-content pt-0 bg-white max-h-0 overflow-hidden transition-all duration-300"
          style="padding-top:0px;"
        >
          <div id="shade-options">
            <div id="skin-tone-options">
              <h4 class="shade-title">Skin Tone</h4>
            </div>
            <div id="hair-color-options">
              <h4 class="shade-title">Hair Color</h4>
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    <!-- Price Filter Section -->
    {% if section.settings.show_price %}
      <div class="filter-block border rounded overflow-hidden">
        <button
          type="button"
          class="filter-accordion-toggle w-full text-left py-3 px-4 bg-[#c96b3b] text-white font-bold"
        >
          Filter By Price
        </button>
        <div class="filter-accordion-content p-4 bg-white max-h-0 overflow-hidden transition-all duration-300">
          <div id="price-options" class="space-y-2">
            <!-- JS will populate collection checkboxes here -->
          </div>
        </div>
      </div>
    {% endif %}

    {% if section.settings.show_collections %}
      <div class="filter-block border rounded overflow-hidden">
        <button
          type="button"
          class="filter-accordion-toggle w-full text-left py-3 px-4 bg-[#c96b3b] text-white font-bold"
        >
          Filter By Collection
        </button>
        <div class="filter-accordion-content p-4 bg-white max-h-0 overflow-hidden transition-all duration-300">
          <div id="collection-options" class="space-y-2">
            <!-- JS will populate collection checkboxes here -->
          </div>
        </div>
      </div>
    {% endif %}

    {% if section.settings.show_concerns %}
      <div class="filter-block border rounded overflow-hidden">
        <button
          type="button"
          class="filter-accordion-toggle w-full text-left py-3 px-4 bg-[#c96b3b] text-white font-bold"
        >
          Filter By Concerns
        </button>
        <div class="filter-accordion-content p-4 bg-white max-h-0 overflow-hidden transition-all duration-300">
          <div id="concern-options" class="concern-grid">
            <div class="concern-item" data-concern="acne">
              <div class="concern-item-container">
                {% render 'img-concern-acne' %}
                <div class="active-indicator"></div>
              </div>
            </div>
            <div class="concern-item" data-concern="dry-skin">
              <div class="concern-item-container">
                {% render 'img-concern-dry-skin' %}
                <div class="active-indicator"></div>
              </div>
            </div>
            <div class="concern-item" data-concern="large-pores">
              <div class="concern-item-container">
                {% render 'img-concern-large-pores' %}
                <div class="active-indicator"></div>
              </div>
            </div>
            <div class="concern-item" data-concern="patchy-facial-hair">
              <div class="concern-item-container">
                {% render 'img-concern-patchy-facial-hair' %}
                <div class="active-indicator"></div>
              </div>
            </div>
            <div class="concern-item" data-concern="redness">
              <div class="concern-item-container">
                {% render 'img-concern-redness' %}
                <div class="active-indicator"></div>
              </div>
            </div>
            <div class="concern-item" data-concern="oily-and-shiny-skin">
              <div class="concern-item-container">
                {% render 'img-concern-oily-and-shiny-skin' %}
                <div class="active-indicator"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    <div class="start-help text-sm mt-6" style="display: none;">
      <p>
        <strong class="text-[#1f2937]">not sure where to start?</strong><br>
        <span class="text-[#374151]">check out our common customer concerns.</span>
      </p>
    </div>
  </form>

