    </span>
  <span class="text_collection">
    <b>Not sure where to start?</b>
Check out our common
customer concerns.
  </span>
  </div>

<script>

  document.getElementById('mobile-filters-toggle')?.addEventListener('click', function () {
    const filters = document.querySelector('.collection-filters');
    const isExpanded = filters.classList.toggle('expanded');
    this.textContent = isExpanded ? 'Hide Filters' : 'Show Filters';
  });

  function renderTagOptions(containerId, items, { className, type = 'div', isPair = false } = {}) {
    const container = document.getElementById(containerId);
    if (!container || !Array.isArray(items)) return;
  
    items.forEach(entry => {
      const [value, labelText] = isPair ? entry : [entry, entry.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase())];
  
      const el = document.createElement(type);
      el.className = className;
      el.setAttribute('data-value', value);
  
      const label = document.createElement('span');
      label.textContent = labelText;
  
      const check = document.createElement('span');
      check.className = 'checkmark';
      check.innerHTML = '✔';
      check.style.display = 'none';
  
      el.appendChild(label);
      el.appendChild(check);
      container.appendChild(el);
    });
  }

  // 1. Populate shade options from variant option name "Shade"
  function populateShadeOptions() {

    // Sort radios
    renderTagOptions("sort-options", [
      ["title-ascending", "Alphabetical A-Z"],
      ["title-descending", "Alphabetical Z–A"],
      ["price-descending", "Price: High to Low"],
      ["created-descending", "Newest Arrivals"]
    ], {
      className: "sort-option",
      isPair: true
    });
    
    // Shades
    const shades = {
      hairColor: [
        "#aa8d7d",
        "#766750",
        "#865f4e",
        "#5b493c",
        "#5c4746",
        "#5c575b",
        "#504b48"
      ],
      skinTone: [
        "#ffd6b6",
        "#ffcda8",
        "#fbc899",
        "#fac4a8",
        "#edb493",
        "#f5b88e",
        "#e2aa85",
        "#f4ae87",
        "#f8b57f",
        "#c4835a",
        "#c07950",
        "#ba6f4b",
        "#9e604b",
        "#976149",
        "#7a4a34",
        "#704230",
        "#5f3c2d"
      ]
    }

    const skinToneContainer = document.getElementById("skin-tone-options");
    shades.skinTone.forEach((color) => {
      const el = document.createElement("div");
      el.className = "filter-swatch";
      el.setAttribute("data-value", color);
      
      const swatch = document.createElement("div");
      swatch.className = "swatch-circle";
      swatch.style.backgroundColor = color;
      
      el.appendChild(swatch);
      skinToneContainer.appendChild(el);
    })

    const hairColorContainer = document.getElementById("hair-color-options");
    shades.hairColor.forEach((color) => {
      const el = document.createElement("div");
      el.className = "filter-swatch";
      el.setAttribute("data-value", color);
      
      const swatch = document.createElement("div");
      swatch.className = "swatch-circle";
      swatch.style.backgroundColor = color;
      
      el.appendChild(swatch);
      hairColorContainer.appendChild(el);
    })
    
  
    // Price ranges
    renderTagOptions("price-options", ["Under $20", "Under $50", "Under $100", "Under $150", "Under $200"], {
      className: "price-option"
    });
  
    // Collection tags
    const allTags = PRODUCTS.flatMap(p => p.tags || []);
    const collections = [...new Set(
      allTags.filter(t => t.startsWith("collection=")).map(t => t.replace("collection=", '').trim())
    )];
    renderTagOptions("collection-options", collections, { className: "collection-option" });
  }

document.addEventListener('DOMContentLoaded', () => {
  document.addEventListener('click', (e) => {
    const target = e.target.closest('.sort-option');
    if (target) {
      document.querySelectorAll('.sort-option').forEach(el => {
        el.classList.remove('active');
        const check = el.querySelector('.checkmark');
        if (check) check.style.display = 'none';
      });
  
      target.classList.add('active');
      const checkmark = target.querySelector('.checkmark');
      if (checkmark) checkmark.style.display = 'inline';
  
      form.dispatchEvent(new Event('change'));
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target.closest('.collection-option');
    if (target) {
      target.classList.toggle('active');
      const checkmark = target.querySelector('.checkmark');
      if (checkmark) {
        checkmark.style.display = target.classList.contains('active') ? 'inline' : 'none';
      }
      form.dispatchEvent(new Event('change'));
    }
  });

  document.addEventListener('click', (e) => {
  const target = e.target.closest('.price-option');
    if (target) {
      document.querySelectorAll('.price-option').forEach(el => {
        el.classList.remove('active');
        const check = el.querySelector('.checkmark');
        if (check) check.style.display = 'none';
      });
  
      target.classList.add('active');
      const checkmark = target.querySelector('.checkmark');
      if (checkmark) checkmark.style.display = 'inline';
  
      form.dispatchEvent(new Event('change'));
    }
  });

  function getSelectedShades() {
    return [...document.querySelectorAll(".filter-swatch.active")].map((el) =>
      el.getAttribute("data-value")
    );
  }
  
  document.addEventListener("click", (e) => {
    if (e.target.closest(".filter-swatch")) {
      e.target.closest(".filter-swatch").classList.toggle("active");
      form.dispatchEvent(new Event("change"));
    }
  });

  // 2. Filtering logic on PRODUCTS
  const form = document.getElementById('collection-filters-form');
  if (form) {
    form.addEventListener('change', () => {
      const selectedShades = getSelectedShades();
      const selectedPrice = getCheckedValues('price')[0] || '';
      const selectedCollections = getCheckedValues('filter_collection');
      const selectedConcerns = getCheckedValues('filter_concern');
      const sortBy = getCheckedValues('sort');

      let filtered = [];

      if(selectedShades.length) {
        const filteredVariants = PRODUCTS.filter(product => {
          const priceMatch = selectedPrice
            ? (product.price < parseFloat(selectedPrice.replace('Under $', '')))
            : true;
      
          const collectionMatch = selectedCollections.length
            ? selectedCollections.some(tag => (product.tags || []).includes(`collection=${tag}`))
            : true;
          
          const concernMatch = selectedConcerns.length
            ? selectedConcerns.some(tag => (product.tags || []).includes(`concern=${tag}`))
            : true;
      
          return priceMatch && collectionMatch && concernMatch;
        }).map(product => product.variants).flat();
        
        filtered = filteredVariants.filter(variant => selectedShades.includes(variant.swatch_color));
        
      }  else {
        filtered = PRODUCTS.filter(product => {
          const priceMatch = selectedPrice
            ? (product.price < parseFloat(selectedPrice.replace('Under $', '')))
            : true;
      
          const collectionMatch = selectedCollections.length
            ? selectedCollections.some(tag => (product.tags || []).includes(`collection=${tag}`))
            : true;
          
          const concernMatch = selectedConcerns.length
            ? selectedConcerns.some(tag => (product.tags || []).includes(`concern=${tag}`))
            : true;
      
          return priceMatch && collectionMatch && concernMatch;
        });
      }
    
      const sortedFiltered = sortProducts(filtered, sortBy);
     // visibleCount = 0; // Reset for new sort
      renderProducts(sortedFiltered);
    });
  }

  function getCheckedValues(name) {
    if (name === 'filter_collection') {
      return [...document.querySelectorAll('.collection-option.active')].map(el =>
        el.getAttribute('data-value')
      );
    }

    if(name === 'filter_concern') {
      return [...document.querySelectorAll('.concern-item.active')]
      .map(el => el.dataset.concern);
    }
  
    if (name === 'price') {
      const selected = document.querySelector('.price-option.active');
      return selected ? [selected.getAttribute('data-value')] : [];
    }

    if (name === 'sort') {
      return document.querySelector('.sort-option.active')?.getAttribute('data-value') || '';
    }
  
    return [...form.querySelectorAll(`input[name="${name}"]:checked`)].map(input => input.value);
  }

  function getCheckedConcerns() {
    return [...document.querySelectorAll('.concern-item.active')].map(el => el.dataset.concern);
  }

  // 3. Toggle concern buttons
  document.querySelectorAll('.concern-item').forEach(item => {
    item.addEventListener('click', () => {
      item.classList.toggle('active');
      form.dispatchEvent(new Event('change'));
    });
  });

  // 4. Simplified accordion toggle
  document.querySelectorAll('.filter-accordion-toggle').forEach(button => {
    const content = button.nextElementSibling;
    button.addEventListener('click', () => {
      button.classList.toggle('open');
      content.classList.toggle('open');
    });
  });
})

  // 5. Initialize

  // setTimeout(
  //   () => populateShadeOptions(),
  //   2000
  // )
  document.addEventListener("DOMContentLoaded", () => {
  if (typeof PRODUCTS !== 'undefined') {
    populateShadeOptions();
  } else {
    // Wait a bit if PRODUCTS isn't ready yet (failsafe)
    const waitForProducts = setInterval(() => {
      if (typeof PRODUCTS !== 'undefined') {
        clearInterval(waitForProducts);
        populateShadeOptions();
      }
    }, 50);
  }
});

// ===== APPEND-ONLY PATCH (helpers + init) =====

// Agar getCheckedValues pehle define nahi hai to define:
if (typeof window.getCheckedValues !== 'function') {
  window.getCheckedValues = function(name) {
    if (name === 'filter_collection') {
      return [...document.querySelectorAll('.collection-option.active')].map(el =>
        el.getAttribute('data-value')
      );
    }
    if (name === 'filter_concern') {
      return [...document.querySelectorAll('.concern-item.active')].map(el =>
        el.getAttribute('data-concern')
      );
    }
    if (name === 'price') {
      const active = document.querySelector('.price-option.active');
      return active ? [active.getAttribute('data-value')] : [];
    }
    if (name === 'sort') {
      const active = document.querySelector('.sort-option.active');
      return active ? active.getAttribute('data-value') : '';
    }
    return [...document.querySelectorAll(`input[name="${name}"]:checked`)].map(i => i.value);
  };
}

// Sort helper (agar missing ho):
if (typeof window.sortProducts !== 'function') {
  window.sortProducts = function(list, sortBy) {
    const arr = [...list];
    switch (sortBy) {
      case 'title-ascending':
        return arr.sort((a,b) => (a.title||'').localeCompare(b.title||''));
      case 'title-descending':
        return arr.sort((a,b) => (b.title||'').localeCompare(a.title||''));
      case 'price-ascending':
        return arr.sort((a,b) => (a.price||0) - (b.price||0));
      case 'price-descending':
        return arr.sort((a,b) => (b.price||0) - (a.price||0));
      case 'created-descending': // newest (heuristic)
        return arr.sort((a,b) => (b.id||0) - (a.id||0));
      default:
        return arr;
    }
  };
}

// Populate (sort, shades, price, collections) agar function maujood hai to chala do:
document.addEventListener('DOMContentLoaded', function () {
  try { 
    if (typeof populateShadeOptions === 'function') {
      populateShadeOptions();
    }
  } catch (e) { /* ignore */ }

  // Sort options ko radio jaise behave karwana (agar #sort-options hai):
  const sortWrap = document.getElementById('sort-options');
  const form = document.getElementById('collection-filters-form');
  if (sortWrap) {
    sortWrap.addEventListener('click', (e) => {
      const opt = e.target.closest('.sort-option');
      if (!opt) return;
      document.querySelectorAll('.sort-option').forEach(x => {
        x.classList.remove('active');
        const c = x.querySelector('.checkmark');
        if (c) c.style.display = 'none';
      });
      opt.classList.add('active');
      const check = opt.querySelector('.checkmark');
      if (check) check.style.display = 'inline';
      form && form.dispatchEvent(new Event('change'));
    });
  }
});


