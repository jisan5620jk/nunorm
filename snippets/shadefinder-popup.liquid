<div class="custom-model-main foundation-popup">
    <div class="custom-modal-inner">        
    <div class="close-btn">×</div>
        <div class="custom-modal-wrap">
            <div class="pop-up-content-wrap">
              <div id="YMK-module"></div>
              <button onclick="applyMakeupBySku('FOUNDATION_01_01')">Apply Foundation Color</button>
              <button onclick="closeYMKModule()">Close</button
              <div class="text-info">FOLLOW THE INSTRUCTIONS ABOVE FOR THE SHADE SCAN TO BEGIN.</div>
            </div>
        </div>  
    </div>  
    <div class="bg-overlay"></div>
</div> 
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
<script>
$(document).ready(function(){

  $(".custom-foundation").click(function(){
    $(".foundation-popup").addClass('model-open');
     
  });
 $(".close-btn, .bg-overlay").click(function(){
  $(".foundation-popup").removeClass('model-open');
});
});
</script>



<script>
var listeners = [];
function registerEvents() {
var l = YMK.addEventListener("loaded", function () {
// do something on 'loaded' event
});
var l2 = YMK.addEventListener("closed", function () {
// do something on 'closed' event
});
listeners.push(l, l2);
}
window.ymkAsyncInit = function () {
registerEvents();
YMK.init({ skinSmoothStrength: 50 });
YMK.openShadeFinder();
};
</script>
<script>
function applyMakeupBySku(itemGuidOrSkuId) {
if (YMK.isLoaded()) {
YMK.applyMakeupBySku(itemGuidOrSkuId);
}
}
function closeYMKModule() {
YMK.close();
for (var l in listeners) {
YMK.removeEventListener(l);
}
}
</script>
<button onclick="applyMakeupBySku('FOUNDATION_01_01')">Apply Foundation
Color</button>
<button onclick="closeYMKModule()">Close</button
