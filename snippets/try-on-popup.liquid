<div data-shade-finder-modal class="custom-model-main try-on-popup">
  <div class="custom-modal-inner">
    <div class="custom-model-message">
      <span id="message_above_popup"
        >Welcome The NuNorm<br>
        <span style="font-weight: 700;">Shade Finder + Try-on Tool</span></span
      >
    </div>
    <div class="custom-modal-wrap">
      <div style="display: block;" class="shade-finder-privacy-policy">
        {{ 'privacy-content.css' | asset_url | stylesheet_tag }}
        {% render 'privacy-content' %}
        <div class="shade-finder-privacy-policy-response-container">
          <input
            data-shade-finder-privacy-policy-response-agree
            type="submit"
            id="agree"
            class="shade-finder-privacy-policy-response-agree"
            value="Agree"
          >
          <input
            data-shade-finder-privacy-policy-response-disagree
            type="submit"
            id="disagree"
            class="shade-finder-privacy-policy-response-disagree"
            value="Disagree"
          >
        </div>
      </div>

      <div style="display: none;" class="pop-up-content-wrap">
        <div id="YMK-module"></div>
        <div id="output"></div>
        <div class="color-shade">
          <div class="custom-shade">
            <div class="color-btn">
              <button data-component-shade-color-group-tab data-index="1" class="shade-color-btn1 shade-color-btn">All Shade</button>
              <button data-component-shade-color-group-tab data-index="2" class="shade-color-btn2 shade-color-btn">Lighter</button>
              <button data-component-shade-color-group-tab data-index="3" class="shade-color-btn3 shade-color-btn active">Best Match</button>
              <button data-component-shade-color-group-tab data-index="4" class="shade-color-btn4 shade-color-btn">Deeper</button>
            </div>
