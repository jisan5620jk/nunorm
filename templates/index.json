      "settings": {
        "custom_liquid": "<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Organization\",\n  \"name\": \"NuNorm\",\n  \"url\": \"https://www.nunorm.com/\",\n  \"logo\": \"https://www.nunorm.com/cdn/shop/files/nunorm-logo-gradient.png?v=1743106885&width=180\",\n  \"description\": \"NuNorm is a modern men’s grooming and cosmetic brand dedicated to redefining confidence through simple, effective, and everyday-use makeup and skincare solutions for men. Built on the belief that self-care should be accessible, effortless, and stigma-free, NuNorm creates performance-driven products that help men look fresh, feel confident, and enhance their natural features without complication. Our formulations are lightweight, blendable, and tailored to men’s skin needs, offering results that look natural—not noticeable. From tinted hydrators and quick coverage essentials to shine control and brow grooming, every product is crafted to fit seamlessly into a man’s routine. Designed and tested in the United States, NuNorm continues to champion a new standard of personal grooming for men—one that celebrates authenticity, simplicity, and confidence.\",\n  \"address\": {\n    \"@type\": \"PostalAddress\",\n    \"streetAddress\": \"3290 W Big Beaver Road #300\",\n    \"addressLocality\": \"Troy\",\n    \"addressRegion\": \"MI\",\n    \"postalCode\": \"48084\",\n    \"addressCountry\": \"US\"\n  },\n  \"areaServed\": \"United States\",\n  \"keywords\": \"skin care products for men, male makeup, makeup for guys, makeup for men, mens foundation, cosmetics for men, make up for men, men's makeup products, men s makeup\",\n  \"sameAs\": [\n    \"https://www.instagram.com/mynunorm/\",\n    \"http://tiktok.com/@mynunorm\",\n    \"https://www.facebook.com/mynunorm\",\n    \"https://www.youtube.com/@mynunorm\"\n  ],\n  \"contactPoint\": {\n    \"@type\": \"ContactPoint\",\n    \"contactType\": \"Customer Support\",\n    \"email\": \"hello@nunorm.com\",\n    \"areaServed\": \"United States\",\n    \"availableLanguage\": [\"English\"]\n  }\n}\n</script>",
